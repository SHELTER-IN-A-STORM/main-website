];

const sortedResources = [...resources].sort((a, b) => {
  if (a.categories.includes('our-services')) return -1;
  if (b.categories.includes('our-services')) return 1;
  if (a.categories.includes('partner')) return -1;
  if (b.categories.includes('partner')) return 1;
  return Math.random() - 0.5;
});
---

<Layout title="Resources">
  <main>

    <!-- Header -->
    <section class="pt-40 pb-16 lg:pt-48 lg:pb-20">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Resources</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-black leading-[1.1] tracking-tight mb-6" style="text-wrap: balance;">
          Find the help you need.
        </h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto leading-relaxed">
          A directory of trusted organizations and hotlines for specialized support.
        </p>
      </div>
    </section>

    <!-- Search + Resources -->
    <section class="pb-24 lg:pb-32">
      <div class="max-w-3xl mx-auto px-6">

        <!-- Search -->
        <div class="mb-8">
          <input
            id="search-input"
            type="text"
            placeholder="Search resources..."
            class="w-full px-4 py-3 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
          />
        </div>

        <!-- Category filters -->
        <div class="flex flex-wrap gap-2 mb-8">
          {categories.map(cat => (
            <button
              class="category-filter px-3 py-1.5 text-xs font-medium border border-gray-200 rounded-full text-gray-500 hover:border-gray-400 transition-colors"
              data-category={cat.id}
            >
              {cat.name}
            </button>
          ))}
        </div>

        <!-- Status -->
        <div id="search-status" class="text-xs text-gray-400 mb-6 hidden">
          <span id="results-count"></span>
        </div>

        <!-- No results -->
        <div id="no-results" class="hidden py-16 text-center border border-gray-100 rounded-xl">
          <p class="text-gray-400 mb-1">No matches found.</p>
          <button onclick="clearSearch()" class="text-sm font-semibold text-black hover:underline">Clear search</button>
        </div>

        <!-- Resource list -->
        <div id="resources-container" class="divide-y divide-gray-100">
          {sortedResources.map(resource => (
            <div
              class="resource-item py-5 first:pt-0"
              data-name={resource.name.toLowerCase()}
              data-description={resource.description.toLowerCase()}
              data-keywords={resource.keywords.toLowerCase()}
              data-categories={resource.categories.join(',')}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0">
                  <div class="flex items-center gap-2 mb-1 flex-wrap">
                    <h3 class="text-sm font-semibold text-black">{resource.name}</h3>
                    {resource.categories.includes('our-services') && (
                      <span class="text-[10px] font-medium uppercase tracking-wide text-gray-400 border border-gray-200 px-1.5 py-0.5 rounded">Ours</span>
                    )}
                    {resource.categories.includes('partner') && (
                      <span class="text-[10px] font-medium uppercase tracking-wide text-gray-400 border border-gray-200 px-1.5 py-0.5 rounded">Partner</span>
                    )}
                  </div>
                  <p class="text-sm text-gray-500 leading-relaxed">{resource.description}</p>
                </div>
                <a
                  href={resource.link}
                  target={resource.link.startsWith('/') ? '_self' : '_blank'}
                  rel={resource.link.startsWith('/') ? undefined : 'noopener noreferrer'}
                  class="shrink-0 text-sm font-semibold text-brand hover:underline whitespace-nowrap"
                >
                  Visit &rarr;
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-5">
          Need immediate help?
        </h2>
        <p class="text-gray-400 leading-relaxed mb-10">
          If you're in an emergency, call 911. For non-emergency assistance, submit a request and our team will respond within 2&ndash;3 business days.
        </p>
        <a href="/get-help" class="inline-block px-7 py-3.5 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
          Request assistance
        </a>
      </div>
    </section>

  </main>
</Layout>

<script is:inline>
  window.clearSearch = function() {
    var input = document.getElementById('search-input');
    if (input) input.value = '';
    window.selectedCategories.clear();
    document.querySelectorAll('.category-filter').forEach(function(f) {
      f.classList.remove('bg-black', 'text-white', 'border-black');
    });
    window.filterResources();
  };
</script>

<script>
  declare global {
    interface Window {
      selectedCategories: Set<string>;
      filterResources: () => void;
      clearSearch: () => void;
    }
  }

  window.selectedCategories = new Set();

  const searchInput = document.getElementById('search-input') as HTMLInputElement;
  const categoryFilters = document.querySelectorAll('.category-filter');
  const resourceItems = document.querySelectorAll('.resource-item');
  const noResults = document.getElementById('no-results');
  const searchStatus = document.getElementById('search-status');
  const resultsCount = document.getElementById('results-count');

  window.filterResources = function() {
    const terms = (searchInput?.value || '').toLowerCase().trim().split(/\s+/).filter(Boolean);
    let visible = 0;

    resourceItems.forEach(item => {
      const el = item as HTMLElement;
      const text = `${el.dataset.name} ${el.dataset.description} ${el.dataset.keywords}`;
      const cats = (el.dataset.categories || '').split(',');

      const matchesSearch = !terms.length || terms.some(t => text.includes(t));
      const matchesCats = window.selectedCategories.size === 0 || cats.some(c => window.selectedCategories.has(c));

      if (matchesSearch && matchesCats) {
        el.style.display = '';
        visible++;
      } else {
        el.style.display = 'none';
      }
    });

    if (searchStatus && resultsCount) {
      if (terms.length || window.selectedCategories.size) {
        searchStatus.classList.remove('hidden');
        resultsCount.textContent = `${visible} result${visible !== 1 ? 's' : ''} found`;
      } else {
        searchStatus.classList.add('hidden');
      }
    }

    if (noResults) {
      const container = document.getElementById('resources-container');
      if (visible === 0) {
        noResults.classList.remove('hidden');
        container?.classList.add('hidden');
      } else {
        noResults.classList.add('hidden');
        container?.classList.remove('hidden');
      }
    }
  };

  function debounce(fn: Function, ms: number) {
    let t: number;
    return (...args: any[]) => { clearTimeout(t); t = setTimeout(() => fn(...args), ms) as unknown as number; };
  }

  searchInput?.addEventListener('input', debounce(window.filterResources, 200));

  categoryFilters.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = (btn as HTMLElement).dataset.category;
      if (!cat) return;
      if (window.selectedCategories.has(cat)) {
        window.selectedCategories.delete(cat);
        btn.classList.remove('bg-black', 'text-white', 'border-black');
      } else {
        window.selectedCategories.add(cat);
        btn.classList.add('bg-black', 'text-white', 'border-black');
      }
      window.filterResources();
    });
  });

  window.filterResources();
</script>
