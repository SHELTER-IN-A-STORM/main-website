---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';

const pantry = siteConfig.shelter.pantry;
---

<Layout title="Food Pantry | Shelter in a Storm">
  <main>

    <!-- Header -->
    <section class="pt-40 pb-20 lg:pt-48 lg:pb-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">24/7 Food Pantry</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-black leading-[1.1] tracking-tight mb-6" style="text-wrap: balance;">
          Take what you need, leave some for others.
        </h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto leading-relaxed">
          No paperwork. No questions. Just food when you need it &mdash; available around the clock, every single day.
        </p>
      </div>
    </section>

    <!-- Quick facts -->
    <section class="border-t border-b border-gray-100">
      <div class="max-w-4xl mx-auto px-6 py-12 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        <div>
          <p class="text-2xl font-bold text-black">24/7</p>
          <p class="text-sm text-gray-400 mt-1">Always open</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-black">No ID required</p>
          <p class="text-sm text-gray-400 mt-1">Come as you are</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-black">Free</p>
          <p class="text-sm text-gray-400 mt-1">For anyone in need</p>
        </div>
      </div>
    </section>

    <!-- Photo + About -->
    <section class="py-24 lg:py-32">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="rounded-xl overflow-hidden">
            <img
              src="https://images.unsplash.com/photo-1615897570493-84cdd8a9853b?w=1200&q=80&auto=format&fit=crop"
              alt="Food pantry shelves stocked with items"
              class="w-full aspect-[4/3] object-cover"
            />
          </div>
          <div>
            <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-6">
              {pantry.title}
            </h2>
            <p class="text-gray-500 leading-relaxed mb-8">
              {pantry.description}
            </p>
            <div class="space-y-4">
              <h3 class="text-xs text-gray-400 font-medium uppercase tracking-wide">What's available</h3>
              <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-gray-600">
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 bg-black rounded-full shrink-0"></span>
                  Non-perishable food
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 bg-black rounded-full shrink-0"></span>
                  Hygiene supplies
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 bg-black rounded-full shrink-0"></span>
                  Emergency food boxes
                </li>
                <li class="flex items-center gap-2">
                  <span class="w-1 h-1 bg-black rounded-full shrink-0"></span>
                  Personal care items
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Location & Map -->
    <section id="location" class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
          <div>
            <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Find us</p>
            <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-6">
              Location &amp; directions
            </h2>

            <div class="space-y-8">
              <div>
                <p class="text-sm font-medium text-black mb-1">Address</p>
                <p class="text-gray-500 leading-relaxed">
                  {pantry.location.address}<br />
                  {pantry.location.city}, {pantry.location.state} {pantry.location.zip}
                </p>
                <p class="text-sm text-gray-400 mt-2">{pantry.location.directions}</p>
              </div>

              <div>
                <p class="text-sm font-medium text-black mb-1">Hours</p>
                <p class="text-gray-500">Open 24 hours a day, 7 days a week</p>
              </div>

              <a
                href="https://www.google.com/maps/dir//Lake+Ozark+Christian+Church"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors"
              >
                Get directions
              </a>
            </div>
          </div>

          <div class="border border-gray-100 rounded-xl overflow-hidden">
            <iframe
              width="100%"
              height="420"
              style="border:0;display:block"
              loading="lazy"
              allowfullscreen
              referrerpolicy="no-referrer-when-downgrade"
              title="Lake Ozark Christian Church Food Pantry Location"
              aria-label="Map showing the location of our food pantry"
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3135.497843479267!2d-92.64396702409653!3d38.19833697188163!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x87c4c5de89ac8075%3A0xd6b3ef02b5ac85cf!2sLake%20Ozark%20Christian%20Church!5e0!3m2!1sen!2sus!4v1737500655692!5m2!1sen!2sus"
            ></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- More help -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-5">
          Need more than food?
        </h2>
        <p class="text-gray-400 leading-relaxed mb-10">
          We also provide emergency financial assistance for utilities, rent, and other crisis situations. Fill out a request and we'll do our best to help.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/get-help" class="px-7 py-3.5 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
            Request assistance
          </a>
          <a
            href="https://hopehouseofmillercounty.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-7 py-3.5 border border-gray-200 text-black font-semibold text-sm rounded-lg hover:border-gray-300 transition-colors"
          >
            Hope House of Miller County
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>
