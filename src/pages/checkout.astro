---
import Layout from '../layouts/Layout.astro';
import { eventConfig } from '../config/event';

const { tickets, sponsors, raffle, dipOff, donation, auction, schedule, highlights, extras, documents } = eventConfig;

let auctionItems: any[] = [];
if (auction) {
  try {
    const res = await fetch(auction.apiUrl);
    if (res.ok) {
      const data = await res.json();
      auctionItems = (data.items || [])
        .sort((a: any, b: any) => (b.value || 0) - (a.value || 0))
        .slice(0, auction.previewCount);
    }
  } catch { auctionItems = []; }
}

const hasIntentOptions = [tickets, sponsors].filter(Boolean).length > 0;
const clientConfig = JSON.stringify({
  name: eventConfig.name,
  date: eventConfig.date,
  stripeApiUrl: eventConfig.stripeApiUrl,
  tickets: tickets ? { price: tickets.price, maxPerOrder: tickets.maxPerOrder } : null,
  sponsors: sponsors ? { tiers: sponsors.tiers.map(t => ({ id: t.id, name: t.name, price: t.price, seats: t.seats, raffleTickets: t.raffleTickets })) } : null,
  raffle: raffle ? { packages: raffle.packages, maxPerPackage: raffle.maxPerPackage } : null,
  dipOff: dipOff ? { categories: dipOff.categories } : null,
  donation: donation && donation.enabled ? true : false,
  extras: extras.map(e => e.id),
});
---

<Layout title={`${eventConfig.name} - Tickets & Checkout`}>
  <main>

    <!-- Demo mode banner (shown only when ?demo is in the URL) -->
    <div id="demoBanner" class="hidden fixed top-0 inset-x-0 z-50 bg-black text-white text-center text-xs font-semibold py-2 px-4">
      DEMO MODE — your order will be charged a flat $1.00 test amount, not the real total.
    </div>

    <!-- Header -->
    <section class="pt-32 pb-12 lg:pt-40 lg:pb-16">
      <div class="max-w-2xl mx-auto px-6">
        <div class="text-center mb-8">
          <p class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-2">Upcoming Event</p>
          <h1 class="text-2xl lg:text-3xl font-bold text-black tracking-tight mb-3">{eventConfig.name}</h1>
          <p class="text-sm text-gray-500 leading-relaxed">{eventConfig.tagline}</p>
        </div>

        <div class="flex flex-wrap justify-center gap-3 text-sm">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200">
            <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/></svg>
            {eventConfig.date}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200">
            <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            {eventConfig.time}
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-gray-200">
            <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/></svg>
            {eventConfig.location}
          </span>
        </div>
      </div>
    </section>

    <!-- Schedule & Highlights -->
    {(schedule || highlights) && (
      <section class="border-t border-gray-100">
        <div class="max-w-3xl mx-auto px-6 py-12 lg:py-16">
          <div class={`grid gap-8 ${schedule && highlights ? 'md:grid-cols-2' : ''}`}>

            {schedule && (
              <div class="rounded-xl border border-gray-200 p-5">
                <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-4">Schedule</p>
                <div class="space-y-4">
                  {schedule.map(item => (
                    <div class="flex gap-3">
                      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-black text-white text-xs font-semibold">{item.time.replace(/\s*(AM|PM)/i, '')}</div>
                      <div>
                        <p class="text-sm font-semibold text-black">{item.title}</p>
                        <p class="text-xs text-gray-500 mt-0.5">{item.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {highlights && (
              <div class="rounded-xl border border-gray-200 p-5">
                <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-4">What to expect</p>
                <div class="space-y-3">
                  {highlights.map(h => (
                    <div class="flex gap-2.5">
                      <svg class="mt-0.5 h-4 w-4 shrink-0 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                      <div>
                        <p class="text-sm font-semibold text-black">{h.title}</p>
                        <p class="text-xs text-gray-500">{h.description}</p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        </div>
      </section>
    )}

    <!-- Auction Preview -->
    {auction && (
      <section class="border-t border-gray-100">
        <div class="max-w-4xl mx-auto px-6 py-12 lg:py-16">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-2 text-center">Silent Auction</p>
          <p class="text-center text-sm text-gray-500 mb-8">Preview the top items you can bid on at the event.</p>

          {auctionItems.length > 0 ? (
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
              {auctionItems.map((item: any) => (
                <a
                  href={`${auction.siteUrl}/app/items/${item.id}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group rounded-xl border border-gray-200 overflow-hidden hover:border-gray-300 transition-colors"
                >
                  <div class="relative">
                    {item.imageUrl ? (
                      <img src={item.imageUrl} alt={item.title} class="w-full h-40 object-cover" loading="lazy" />
                    ) : (
                      <div class="w-full h-40 bg-gray-100 flex items-center justify-center">
                        <svg class="w-8 h-8 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      </div>
                    )}
                    <span class="absolute top-2 right-2 bg-black text-white text-xs font-semibold px-2 py-0.5 rounded-full">${item.startingBid}</span>
                  </div>
                  <div class="p-4">
                    <p class="text-sm font-semibold text-black line-clamp-1 group-hover:underline">{item.title}</p>
                    <p class="text-xs text-gray-500 mt-1 line-clamp-2">{item.description}</p>
                    <div class="flex items-center justify-between mt-3 text-xs text-gray-500">
                      <span>Value: ${item.value}</span>
                      {item.bidCount > 0 && <span class="font-medium text-black">{item.bidCount} bid{item.bidCount > 1 ? 's' : ''}</span>}
                    </div>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-8 text-center">
              <p class="text-sm text-gray-500">Auction items will be available soon. Check back later!</p>
            </div>
          )}

          <div class="text-center mt-6 space-y-3">
            <a href={auction.siteUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
              Start Bidding
            </a>
            <p class="text-xs text-gray-500">
              Want to donate an item to the Silent Auction? Email <a href={`mailto:${auction.donateEmail}`} class="text-black font-medium underline">{auction.donateEmail}</a>
            </p>
          </div>
        </div>
      </section>
    )}

    <!-- Checkout -->
    <section id="tickets" class="border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-6 py-12 lg:py-16">
        <div class="text-center mb-8">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-2">Register</p>
          <p class="text-sm text-gray-500">Select how you'd like to support this event.</p>
        </div>

        <form id="checkoutForm" novalidate>

          <!-- Step 1: Intent Selection -->
          <div class="checkout-step" data-step="1">
            {hasIntentOptions && (
              <div class={`grid gap-3 mb-6 ${tickets && sponsors ? 'sm:grid-cols-2' : ''}`}>
                {tickets && (
                  <button type="button" class="intent-btn rounded-xl border border-gray-200 p-5 text-left hover:border-black transition-colors" data-intent="tickets">
                    <p class="text-sm font-semibold text-black">Register / Buy Tickets</p>
                    <p class="text-xs text-gray-500 mt-1">Admission, raffle tickets, Dip-Off entry &amp; donations</p>
                    <p class="text-lg font-bold text-black mt-3">${tickets.price}<span class="text-xs font-normal text-gray-500"> / admission</span></p>
                  </button>
                )}
                {sponsors && (
                  <button type="button" class="intent-btn rounded-xl border border-gray-200 p-5 text-left hover:border-black transition-colors" data-intent="sponsor">
                    <p class="text-sm font-semibold text-black">Become a Sponsor</p>
                    <p class="text-xs text-gray-500 mt-1">Support the event with a sponsor package</p>
                    <p class="text-lg font-bold text-black mt-3">${sponsors.tiers[sponsors.tiers.length - 1].price.toLocaleString()}&ndash;${sponsors.tiers[0].price.toLocaleString()}</p>
                  </button>
                )}
              </div>
            )}

            <a href="/donate" class="block rounded-xl border border-gray-200 p-4 text-center hover:border-black transition-colors">
              <p class="text-sm text-gray-500">Just want to donate? <span class="font-semibold text-black">Give here &rarr;</span></p>
            </a>
          </div>

          <!-- Step 2: Ticket Flow -->
          {tickets && (
            <div class="checkout-step hidden" data-step="2" data-flow="tickets">
              <button type="button" class="btn-back text-sm text-gray-500 hover:text-black transition-colors mb-6">&larr; Back</button>

              <!-- Contact -->
              <div class="rounded-xl border border-gray-200 p-5 mb-4">
                <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-4">Your Information</p>
                <div class="space-y-3">
                  <div>
                    <label class="block text-sm font-medium text-black mb-1.5">Full Name *</label>
                    <input type="text" name="name" required placeholder="Jane Doe" class="checkout-field" />
                  </div>
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-sm font-medium text-black mb-1.5">Email *</label>
                      <input type="email" name="email" required placeholder="you@example.com" class="checkout-field" />
                    </div>
                    <div>
                      <label class="block text-sm font-medium text-black mb-1.5">Phone</label>
                      <input type="tel" name="phone" placeholder="(555) 123-4567" class="checkout-field" />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Ticket quantity -->
              <div class="rounded-xl border border-gray-200 p-5 mb-4">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="text-sm font-semibold text-black">{tickets.label}</p>
                    <p class="text-xs text-gray-500 mt-0.5">{tickets.description}</p>
                    <p class="text-lg font-bold text-black mt-2">${tickets.price}<span class="text-xs font-normal text-gray-500"> / person</span></p>
                  </div>
                  <div class="flex items-center gap-3">
                    <button type="button" class="qty-btn h-9 w-9 rounded-full border border-gray-200 flex items-center justify-center text-lg hover:bg-gray-50 transition-colors" data-action="decrease" data-type="regular">&minus;</button>
                    <span class="qty-display w-8 text-center font-semibold" data-type="regular">0</span>
                    <button type="button" class="qty-btn h-9 w-9 rounded-full border border-gray-200 flex items-center justify-center text-lg hover:bg-gray-50 transition-colors" data-action="increase" data-type="regular">&plus;</button>
                  </div>
                </div>
              </div>

              <!-- Raffle packages (ticket flow) -->
              {raffle && (
                <div class="rounded-xl border border-gray-200 p-5 mb-4">
                  <p class="text-sm font-semibold text-black mb-1">Raffle Tickets</p>
                  <p class="text-xs text-gray-500 mb-4">Choose a package (or more than one).</p>
                  <div class="space-y-3">
                    {raffle.packages.map(pkg => (
                      <div class="flex items-center justify-between">
                        <div class="text-sm text-gray-500"><span class="font-medium text-black">{pkg.tickets} tickets</span> &middot; ${pkg.price}</div>
                        <div class="flex items-center gap-3">
                          <button type="button" class="qty-btn h-9 w-9 rounded-full border border-gray-200 flex items-center justify-center text-lg hover:bg-gray-50 transition-colors" data-action="decrease" data-type={`raffle-${pkg.id}`}>&minus;</button>
                          <span class="qty-display w-8 text-center font-semibold" data-type={`raffle-${pkg.id}`}>0</span>
                          <button type="button" class="qty-btn h-9 w-9 rounded-full border border-gray-200 flex items-center justify-center text-lg hover:bg-gray-50 transition-colors" data-action="increase" data-type={`raffle-${pkg.id}`}>&plus;</button>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              <!-- Dip-Off Competition -->
              {dipOff && (
                <div class="rounded-xl border border-gray-200 p-5 mb-4">
                  <label class="flex items-start gap-3 cursor-pointer">
                    <input type="checkbox" id="dipOffToggle" name="dipOffEntry" class="mt-0.5 h-4 w-4 accent-black rounded" />
                    <div>
                      <p class="text-sm font-medium text-black">{dipOff.label}</p>
                      <p class="text-xs text-gray-500">{dipOff.description}</p>
                    </div>
                  </label>
                  <div id="dipOffCategories" class="hidden mt-4 pl-7 space-y-2">
                    {dipOff.categories.map(cat => (
                      <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" name="dipOffCategory" value={cat.id} class="dipoff-cat h-4 w-4 accent-black rounded" />
                        <span class="text-sm text-gray-500">{cat.label}</span>
                      </label>
                    ))}
                    <p class="text-xs text-gray-500 pt-1">{dipOff.note}</p>
                  </div>
                </div>
              )}

              <!-- Donation -->
              {donation && donation.enabled && (
                <div class="rounded-xl border border-gray-200 p-5 mb-4">
                  <p class="text-sm font-semibold text-black mb-1">{donation.label}</p>
                  <p class="text-xs text-gray-500 mb-3">{donation.description}</p>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">$</span>
                    <input type="number" name="donation" min="0" step="1" placeholder="0" class="checkout-field pl-7" />
                  </div>
                </div>
              )}

              <!-- Extras -->
              {extras.length > 0 && (
                <div class="space-y-2 mb-6">
                  {extras.map(ex => (
                    <label class="flex items-start gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer hover:border-black transition-colors">
                      <input type="checkbox" name={ex.id} class="extra-check mt-0.5 h-4 w-4 accent-black rounded" />
                      <div>
                        <p class="text-sm font-medium text-black">{ex.label}</p>
                        <p class="text-xs text-gray-500">{ex.description}</p>
                      </div>
                    </label>
                  ))}
                </div>
              )}

              <button type="button" class="btn-review w-full px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
                Review Order
              </button>
            </div>
          )}

          <!-- Step 2: Sponsor Flow -->
          {sponsors && (
            <div class="checkout-step hidden" data-step="2" data-flow="sponsor">
              <button type="button" class="btn-back text-sm text-gray-500 hover:text-black transition-colors mb-6">&larr; Back</button>

              <!-- Contact -->
              <div class="rounded-xl border border-gray-200 p-5 mb-4">
                <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-4">Your Information</p>
                <div class="space-y-3">
                  <div>
                    <label class="block text-sm font-medium text-black mb-1.5">Name / Business Name *</label>
                    <input type="text" name="sponsor-name" required placeholder="Acme Co. / Jane Doe" class="checkout-field" />
                  </div>
                  <div class="grid sm:grid-cols-2 gap-3">
                    <div>
                      <label class="block text-sm font-medium text-black mb-1.5">Email *</label>
                      <input type="email" name="sponsor-email" required placeholder="you@example.com" class="checkout-field" />
                    </div>
                    <div>
                      <label class="block text-sm font-medium text-black mb-1.5">Phone</label>
                      <input type="tel" name="sponsor-phone" placeholder="(555) 123-4567" class="checkout-field" />
                    </div>
                  </div>
                </div>
              </div>

              <!-- Sponsor tiers -->
              <div class="space-y-3 mb-4">
                {sponsors.tiers.map(tier => (
                  <label class="sponsor-tier flex items-center justify-between rounded-xl border border-gray-200 p-5 cursor-pointer hover:border-black transition-colors">
                    <div class="pr-4">
                      <input type="radio" name="sponsor-tier" value={tier.id} class="sr-only peer" />
                      <p class="text-sm font-semibold text-black">{tier.name}</p>
                      <p class="text-xs text-gray-500 mt-0.5">{tier.perks}</p>
                      <p class="text-xs text-gray-500 mt-1">
                        Includes {tier.seats > 0 ? `${tier.seats} admission ${tier.seats === 1 ? 'ticket' : 'tickets'}` : 'recognition'}
                        {tier.raffleTickets > 0 ? ` + ${tier.raffleTickets} raffle tickets` : ''}
                      </p>
                    </div>
                    <p class="text-lg font-bold text-black whitespace-nowrap">${tier.price.toLocaleString()}</p>
                  </label>
                ))}
              </div>

              <!-- Extra tickets for sponsors -->
              {tickets && (
                <div class="rounded-xl border border-gray-200 p-5 mb-4">
                  <p class="text-sm font-semibold text-black mb-1">Additional Tickets</p>
                  <p class="text-xs text-gray-500 mb-3">Need more seats beyond your sponsor package?</p>
                  <div class="flex items-center justify-between">
                    <p class="text-sm text-gray-500">${tickets.price} / person</p>
                    <div class="flex items-center gap-3">
                      <button type="button" class="qty-btn h-9 w-9 rounded-full border border-gray-200 flex items-center justify-center text-lg hover:bg-gray-50 transition-colors" data-action="decrease" data-type="sponsor-extra">&minus;</button>
                      <span class="qty-display w-8 text-center font-semibold" data-type="sponsor-extra">0</span>
                      <button type="button" class="qty-btn h-9 w-9 rounded-full border border-gray-200 flex items-center justify-center text-lg hover:bg-gray-50 transition-colors" data-action="increase" data-type="sponsor-extra">&plus;</button>
                    </div>
                  </div>
                </div>
              )}

              <!-- Donation for sponsors -->
              {donation && donation.enabled && (
                <div class="rounded-xl border border-gray-200 p-5 mb-4">
                  <p class="text-sm font-semibold text-black mb-1">{donation.label}</p>
                  <p class="text-xs text-gray-500 mb-3">{donation.description}</p>
                  <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-500 text-sm">$</span>
                    <input type="number" name="sponsor-donation" min="0" step="1" placeholder="0" class="checkout-field pl-7" />
                  </div>
                </div>
              )}

              <!-- Extras for sponsors -->
              {extras.length > 0 && (
                <div class="space-y-2 mb-6">
                  {extras.map(ex => (
                    <label class="flex items-start gap-3 rounded-xl border border-gray-200 p-4 cursor-pointer hover:border-black transition-colors">
                      <input type="checkbox" name={`sponsor-${ex.id}`} class="extra-check mt-0.5 h-4 w-4 accent-black rounded" />
                      <div>
                        <p class="text-sm font-medium text-black">{ex.label}</p>
                        <p class="text-xs text-gray-500">{ex.description}</p>
                      </div>
                    </label>
                  ))}
                </div>
              )}

              <button type="button" class="btn-review w-full px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
                Review Order
              </button>
            </div>
          )}

          <!-- Step 3: Review & Pay -->
          <div class="checkout-step hidden" data-step="3">
            <button type="button" class="btn-back text-sm text-gray-500 hover:text-black transition-colors mb-6">&larr; Back</button>

            <div class="rounded-xl border border-gray-200 p-5 mb-4">
              <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-4">Order Summary</p>
              <div id="orderSummary" class="space-y-2 text-sm"></div>
              <div class="border-t border-gray-100 pt-3 mt-3 flex justify-between text-base font-bold text-black">
                <span>Total</span>
                <span id="totalAmount">$0.00</span>
              </div>
            </div>

            {documents && documents.length > 0 && (
              <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 mb-4">
                <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-3">Documents</p>
                <div class="space-y-2">
                  {documents.map(doc => (
                    <a href={doc.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm text-black hover:underline">
                      <svg class="h-4 w-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/></svg>
                      {doc.label}
                    </a>
                  ))}
                </div>
              </div>
            )}

            <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 mb-6">
              <div class="flex items-center gap-3">
                <svg class="h-5 w-5 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/></svg>
                <div>
                  <p class="text-sm font-medium text-black">Secure Payment</p>
                  <p class="text-xs text-gray-500">You'll be redirected to our secure payment processor and emailed a receipt. Tax-deductible contribution.</p>
                </div>
              </div>
            </div>

            <button type="submit" id="payBtn" class="w-full px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
              <span class="pay-text">Complete Purchase</span>
              <span class="pay-loading hidden">Processing...</span>
            </button>
          </div>

          <!-- Error display (outside steps so it's always visible) -->
          <div id="checkoutError" class="hidden mt-4 rounded-lg border border-gray-200 bg-gray-50 p-4 text-center text-sm text-gray-500"></div>

        </form>
      </div>
    </section>

  </main>
</Layout>

<style>
  .checkout-field {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: white;
    font-size: 0.875rem;
    color: #111;
    transition: border-color 0.15s ease;
  }
  .checkout-field::placeholder { color: #d1d5db; }
  .checkout-field:focus {
    outline: none;
    border-color: #111;
    box-shadow: 0 0 0 1px #111;
  }
  .checkout-step.hidden { display: none; }
  #dipOffCategories.hidden { display: none; }
  .intent-btn.selected { border-color: #111; background: #fafafa; }
  .sponsor-tier:has(input:checked) { border-color: #111; background: #fafafa; }
  .line-clamp-1 { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>

<script is:inline define:vars={{ clientConfig }}>
(function() {
  const CFG = JSON.parse(clientConfig);
  // Demo mode (?demo in the URL): collapse the whole order to a flat $1.00 test
  // charge so the full Stripe → /thanks → receipt flow can be exercised for real
  // without real amounts. Applied identically to the summary, charge, and receipt.
  const DEMO = new URLSearchParams(location.search).has('demo');
  const DEMO_ITEM = { name: 'Demo registration — $1 test charge', cost: 1 };
  if (DEMO) {
    const b = document.getElementById('demoBanner');
    if (b) b.classList.remove('hidden');
  }

  let flow = null;
  const state = {
    name: '', email: '', phone: '',
    regularTickets: 0,
    sponsorTier: null,
    sponsorExtraTickets: 0,
    rafflePkgs: {},          // { pkgId: qty }
    dipOffEntry: false,
    dipOffCategories: [],
    donation: 0,
    extras: {},
  };

  const $ = (s, ctx) => (ctx || document).querySelector(s);
  const $$ = (s, ctx) => (ctx || document).querySelectorAll(s);
  const form = $('#checkoutForm');
  if (!form) return;

  const rafflePkg = (id) => CFG.raffle ? CFG.raffle.packages.find(p => p.id === id) : null;

  // ── Step Navigation ──────────────────────────────────────
  function showStep(n, targetFlow) {
    $$('.checkout-step', form).forEach(el => el.classList.add('hidden'));
    if (n === 2 && targetFlow) {
      const s = $(`.checkout-step[data-step="2"][data-flow="${targetFlow}"]`, form);
      if (s) s.classList.remove('hidden');
    } else {
      const s = $(`.checkout-step[data-step="${n}"]`, form);
      if (s) s.classList.remove('hidden');
    }
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // Intent buttons
  $$('.intent-btn', form).forEach(btn => {
    btn.addEventListener('click', () => {
      $$('.intent-btn', form).forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      flow = btn.dataset.intent;
      showStep(2, flow);
    });
  });

  // Back buttons
  $$('.btn-back', form).forEach(btn => {
    btn.addEventListener('click', () => {
      const currentStep = btn.closest('.checkout-step');
      const step = currentStep ? currentStep.dataset.step : '2';
      if (step === '3') {
        showStep(2, flow);
      } else {
        flow = null;
        $$('.intent-btn', form).forEach(b => b.classList.remove('selected'));
        showStep(1);
      }
    });
  });

  // Review buttons
  $$('.btn-review', form).forEach(btn => {
    btn.addEventListener('click', () => {
      if (!validateForm()) return;
      syncState();
      updateSummary();
      showStep(3);
    });
  });

  // ── Sponsor Tier Selection ───────────────────────────────
  $$('.sponsor-tier', form).forEach(label => {
    label.addEventListener('click', () => {
      const radio = $('input[type="radio"]', label);
      if (radio) {
        radio.checked = true;
        state.sponsorTier = radio.value;
      }
    });
  });

  // ── Dip-Off toggle ───────────────────────────────────────
  const dipToggle = $('#dipOffToggle', form);
  const dipCats = $('#dipOffCategories', form);
  if (dipToggle && dipCats) {
    dipToggle.addEventListener('change', () => {
      dipCats.classList.toggle('hidden', !dipToggle.checked);
      if (!dipToggle.checked) $$('.dipoff-cat', form).forEach(c => { c.checked = false; });
    });
  }

  // ── Quantity Buttons ─────────────────────────────────────
  $$('.qty-btn', form).forEach(btn => {
    btn.addEventListener('click', () => {
      const type = btn.dataset.type;
      const action = btn.dataset.action;
      const display = $(`.qty-display[data-type="${type}"]`, form);
      if (!display) return;

      let val = parseInt(display.textContent) || 0;

      if (action === 'increase') {
        if (type.startsWith('raffle-') && CFG.raffle && val >= CFG.raffle.maxPerPackage) return;
        if ((type === 'regular' || type === 'sponsor-extra') && CFG.tickets && val >= CFG.tickets.maxPerOrder) return;
        val++;
      } else if (action === 'decrease' && val > 0) {
        val--;
      }

      display.textContent = val;

      if (type === 'regular') state.regularTickets = val;
      else if (type === 'sponsor-extra') state.sponsorExtraTickets = val;
      else if (type.startsWith('raffle-')) state.rafflePkgs[type.slice('raffle-'.length)] = val;
    });
  });

  // ── Sync State from DOM ──────────────────────────────────
  function syncState() {
    if (flow === 'sponsor') {
      state.name = ($('input[name="sponsor-name"]', form) || {}).value || '';
      state.email = ($('input[name="sponsor-email"]', form) || {}).value || '';
      state.phone = ($('input[name="sponsor-phone"]', form) || {}).value || '';
      const checked = $('input[name="sponsor-tier"]:checked', form);
      state.sponsorTier = checked ? checked.value : null;
      state.donation = parseFloat(($('input[name="sponsor-donation"]', form) || {}).value) || 0;
    } else {
      state.name = ($('input[name="name"]', form) || {}).value || '';
      state.email = ($('input[name="email"]', form) || {}).value || '';
      state.phone = ($('input[name="phone"]', form) || {}).value || '';
      state.donation = parseFloat(($('input[name="donation"]', form) || {}).value) || 0;
      state.dipOffEntry = !!(dipToggle && dipToggle.checked);
      state.dipOffCategories = Array.from($$('.dipoff-cat:checked', form)).map(c => c.value);
    }
    if (state.donation < 0) state.donation = 0;

    state.extras = {};
    $$('.extra-check', form).forEach(cb => {
      if (cb.checked) state.extras[cb.name.replace('sponsor-', '')] = true;
    });
  }

  // ── Validation ───────────────────────────────────────────
  function validateForm() {
    syncState();
    if (!state.name.trim()) {
      showError('Please enter your name.'); return false;
    }
    if (!state.email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(state.email)) {
      showError('Please enter a valid email address.'); return false;
    }
    if (flow === 'tickets') {
      const raffleCount = Object.values(state.rafflePkgs).reduce((a, b) => a + b, 0);
      if (state.regularTickets === 0 && raffleCount === 0 && state.donation === 0 && !state.dipOffEntry) {
        showError('Please select at least one item.'); return false;
      }
      if (state.dipOffEntry && state.dipOffCategories.length === 0) {
        showError('Please choose at least one Dip-Off category, or uncheck the competition entry.'); return false;
      }
    }
    if (flow === 'sponsor' && !state.sponsorTier) {
      showError('Please select a sponsor package.'); return false;
    }
    hideError();
    return true;
  }

  // ── Order Summary ────────────────────────────────────────
  function buildItems() {
    const items = [];
    let total = 0;

    if (state.regularTickets > 0 && CFG.tickets) {
      const c = state.regularTickets * CFG.tickets.price;
      items.push({ name: `Admission x${state.regularTickets}`, cost: c });
      total += c;
    }

    if (state.sponsorTier && CFG.sponsors) {
      const tier = CFG.sponsors.tiers.find(t => t.id === state.sponsorTier);
      if (tier) {
        const incl = [];
        if (tier.seats > 0) incl.push(`${tier.seats} seats`);
        if (tier.raffleTickets > 0) incl.push(`${tier.raffleTickets} raffle tickets`);
        items.push({ name: `${tier.name}${incl.length ? ` (incl. ${incl.join(' + ')})` : ''}`, cost: tier.price });
        total += tier.price;
      }
    }

    if (state.sponsorExtraTickets > 0 && CFG.tickets) {
      const c = state.sponsorExtraTickets * CFG.tickets.price;
      items.push({ name: `Additional Tickets x${state.sponsorExtraTickets}`, cost: c });
      total += c;
    }

    Object.entries(state.rafflePkgs).forEach(([id, qty]) => {
      if (qty > 0) {
        const pkg = rafflePkg(id);
        if (pkg) {
          const c = pkg.price * qty;
          items.push({ name: `Raffle: ${pkg.tickets} tickets x${qty}`, cost: c });
          total += c;
        }
      }
    });

    if (state.donation > 0) {
      items.push({ name: 'Donation', cost: state.donation });
      total += state.donation;
    }

    if (state.extras.coverFees && total > 0) {
      const fee = Math.round((total * 0.029 + 0.30) * 100) / 100;
      items.push({ name: 'Processing Fee Coverage', cost: fee });
      total += fee;
    }

    if (DEMO && items.length > 0) return { items: [{ ...DEMO_ITEM }], total: DEMO_ITEM.cost };

    return { items, total };
  }

  function updateSummary() {
    const { items, total } = buildItems();
    const extraNotes = [];
    if (state.dipOffEntry && state.dipOffCategories.length > 0) {
      const labels = state.dipOffCategories.map(id => {
        const c = CFG.dipOff.categories.find(x => x.id === id);
        return c ? c.label : id;
      });
      extraNotes.push(`Dip-Off entry: ${labels.join(', ')}`);
    }

    const summaryEl = document.getElementById('orderSummary');
    const totalEl = document.getElementById('totalAmount');
    if (summaryEl) {
      let html = items.length > 0
        ? items.map(i => `<div class="flex justify-between"><span class="text-gray-500">${i.name}</span><span class="text-black font-medium">$${i.cost.toFixed(2)}</span></div>`).join('')
        : '<p class="text-gray-500 text-center py-2">No items selected</p>';
      html += extraNotes.map(n => `<div class="text-xs text-gray-500 pt-1">${n}</div>`).join('');
      summaryEl.innerHTML = html;
    }
    if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
  }

  // ── Submit ───────────────────────────────────────────────
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    syncState();

    const payBtn = document.getElementById('payBtn');
    const payText = payBtn ? payBtn.querySelector('.pay-text') : null;
    const payLoad = payBtn ? payBtn.querySelector('.pay-loading') : null;

    function setLoading(on) {
      if (payBtn) payBtn.disabled = on;
      if (payText) payText.classList.toggle('hidden', on);
      if (payLoad) payLoad.classList.toggle('hidden', !on);
    }

    setLoading(true);
    hideError();

    try {
      const products = [];
      let amt = 0;

      if (state.regularTickets > 0 && CFG.tickets) {
        products.push({ name: 'Admission Ticket', description: `Admission for ${state.regularTickets}`, price: CFG.tickets.price, quantity: state.regularTickets, type: 'admission' });
        amt += state.regularTickets * CFG.tickets.price;
      }

      if (state.sponsorTier && CFG.sponsors) {
        const tier = CFG.sponsors.tiers.find(t => t.id === state.sponsorTier);
        if (tier) {
          products.push({ name: tier.name, description: `${tier.seats} seats, ${tier.raffleTickets} raffle tickets`, price: tier.price, quantity: 1, type: 'sponsor' });
          amt += tier.price;
        }
      }

      if (state.sponsorExtraTickets > 0 && CFG.tickets) {
        products.push({ name: 'Additional Admission', description: `Extra tickets x${state.sponsorExtraTickets}`, price: CFG.tickets.price, quantity: state.sponsorExtraTickets, type: 'admission' });
        amt += state.sponsorExtraTickets * CFG.tickets.price;
      }

      Object.entries(state.rafflePkgs).forEach(([id, qty]) => {
        if (qty > 0) {
          const pkg = rafflePkg(id);
          if (pkg) {
            products.push({ name: `Raffle Tickets (${pkg.tickets})`, description: `${pkg.tickets} raffle tickets`, price: pkg.price, quantity: qty, type: 'prize_entry' });
            amt += pkg.price * qty;
          }
        }
      });

      if (state.donation > 0) {
        products.push({ name: 'Donation', description: 'Additional donation', price: state.donation, quantity: 1, type: 'donation' });
        amt += state.donation;
      }

      if (state.extras.coverFees && amt > 0) {
        const fee = Math.round((amt * 0.029 + 0.30) * 100) / 100;
        products.push({ name: 'Processing Fee Coverage', description: 'Cover payment processing', price: fee, quantity: 1, type: 'fee' });
        amt += fee;
      }

      // Demo mode: replace everything with a single $1 test charge.
      if (DEMO && products.length > 0) {
        products.length = 0;
        products.push({ name: DEMO_ITEM.name, description: '$1.00 test transaction', price: 1, quantity: 1, type: 'demo' });
        amt = 1;
      }

      // Save the order in a cookie ONLY. The email system is NOT contacted here.
      // After Stripe redirects back to /thanks, that page reads this cookie and
      // (only once payment is verified) triggers the receipt.
      const dipLabels = (state.dipOffCategories || []).map(id => {
        const c = CFG.dipOff && CFG.dipOff.categories.find(x => x.id === id);
        return c ? c.label : id;
      });
      const { items: emailItems, total: emailTotal } = buildItems();
      const order = {
        to: state.email,
        name: state.name,
        eventName: CFG.name,
        eventDate: CFG.date,
        items: emailItems.map(i => ({ name: i.name, amount: i.cost })),
        total: emailTotal,
        donation: state.donation,
        dipOffCategories: dipLabels,
      };
      try {
        document.cookie = `sias_order=${encodeURIComponent(JSON.stringify(order))}; path=/; max-age=3600; SameSite=Lax`;
      } catch { /* ignore */ }

      const body = {
        name: state.name,
        email: state.email,
        phone: state.phone,
        eventName: CFG.name,
        eventDate: CFG.date,
        products,
        donation: state.donation,
        dipOffEntry: !!state.dipOffEntry,
        dipOffCategories: state.dipOffCategories,
        coverFees: !!state.extras.coverFees,
      };

      const res = await fetch(CFG.stripeApiUrl, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body),
      });

      let data;
      const ct = res.headers.get('content-type');
      if (ct && ct.includes('application/json')) { data = await res.json(); }
      else { const txt = await res.text(); data = JSON.parse(txt); }

      if (data.success && data.url) {
        window.location.href = data.url;
      } else {
        throw new Error(data.message || 'Failed to create checkout session');
      }
    } catch (err) {
      showError(err.message || 'An error occurred. Please try again.');
      setLoading(false);
    }
  });

  // ── Error Helpers ────────────────────────────────────────
  function showError(msg) {
    const el = document.getElementById('checkoutError');
    if (el) { el.textContent = msg; el.classList.remove('hidden'); el.scrollIntoView({ behavior: 'smooth', block: 'center' }); }
  }
  function hideError() {
    const el = document.getElementById('checkoutError');
    if (el) el.classList.add('hidden');
  }
})();
</script>
