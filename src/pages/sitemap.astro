---
import Layout from '../layouts/Layout.astro';

const pages = [
  {
    title: 'Home',
    path: '',
    description: 'Welcome to Shelter in a Storm — emergency assistance and support in Lake Ozark'
  },
  {
    title: 'About Us',
    path: 'about',
    description: 'Learn about our mission, values, and the team behind Shelter in a Storm'
  },
  {
    title: 'Donate',
    path: 'donate',
    description: 'Support our cause and help those in need in our community'
  },
  {
    title: 'Events',
    path: 'events',
    description: 'Upcoming events, fundraisers, and community gatherings'
  },
  {
    title: 'Get Help',
    path: 'get-help',
    description: 'Access emergency assistance and support services'
  },
  {
    title: 'Food Pantry',
    path: 'services/food-pantry',
    description: '24/7 emergency food assistance for those in need'
  },
  {
    title: 'Volunteer',
    path: 'volunteer',
    description: 'Join our team of volunteers and make a difference'
  },
  {
    title: 'Report',
    path: 'report',
    description: 'Report issues or provide feedback'
  },
  {
    title: 'Legal',
    path: 'legal',
    children: [
      {
        title: 'Privacy Policy',
        path: 'legal/privacy',
        description: 'Our privacy policy and data protection practices'
      },
      {
        title: 'Terms of Service',
        path: 'legal/terms',
        description: 'Terms and conditions for using our services'
      },
      {
        title: 'Accessibility',
        path: 'legal/accessibility',
        description: 'Our commitment to making our services accessible to everyone'
      },
      {
        title: 'License & Attribution',
        path: 'legal/license',
        description: 'Licenses and attributions used on this website'
      }
    ]
  }
];
---

<Layout title="Sitemap">
  <main>
    <section class="pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="max-w-2xl mx-auto px-6">

        <!-- Header -->
        <div class="text-center mb-10">
          <p class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-2">Navigation</p>
          <h1 class="text-2xl lg:text-3xl font-bold text-black tracking-tight mb-3">
            Sitemap
          </h1>
          <p class="text-sm text-gray-500 leading-relaxed">
            All pages available on our website.
          </p>
        </div>

        <!-- Pages -->
        <div class="rounded-xl border border-gray-200 divide-y divide-gray-100">
          {pages.map(page => (
            <div class="p-4">
              {!page.children ? (
                <a href={`/${page.path}`} class="group block">
                  <div class="flex items-center justify-between">
                    <p class="text-sm font-semibold text-black group-hover:underline">{page.title}</p>
                    <svg class="h-4 w-4 text-gray-500 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </div>
                  {page.description && (
                    <p class="text-xs text-gray-500 mt-0.5">{page.description}</p>
                  )}
                </a>
              ) : (
                <div>
                  <p class="text-sm font-semibold text-black mb-3">{page.title}</p>
                  <div class="space-y-2 pl-4 border-l border-gray-100">
                    {page.children.map(child => (
                      <a href={`/${child.path}`} class="group block">
                        <div class="flex items-center justify-between">
                          <p class="text-sm text-black group-hover:underline">{child.title}</p>
                          <svg class="h-3.5 w-3.5 text-gray-500 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                          </svg>
                        </div>
                        {child.description && (
                          <p class="text-xs text-gray-500 mt-0.5">{child.description}</p>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

        <!-- XML sitemap link -->
        <p class="text-center text-xs text-gray-500 mt-6">
          Looking for the XML sitemap?
          <a href="/sitemap.xml" class="text-black hover:underline" target="_blank" rel="noopener noreferrer">View XML Sitemap</a>
        </p>

      </div>
    </section>
  </main>
</Layout>
