---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import PartnersSection from '../components/DonorSection.astro';
import Testimonials from '../components/Testimonials.astro';
import { getImpactStats } from '../lib/api';

const stats = await getImpactStats();
---

<Layout title="Home">

  <!-- Hero -->
  <section class="relative flex items-center justify-center overflow-hidden hero-home">
    <div class="absolute inset-0">
      <img
        src={siteConfig.metadata.openGraph.image}
        alt=""
        class="w-full h-full object-cover"
        fetchpriority="high"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/55"></div>
    </div>
    <div class="relative w-full max-w-3xl mx-auto px-6 text-center">
      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-[1.1] tracking-tight mb-6">
        Emergency assistance when you need it most.
      </h1>
      <p class="text-white/60 text-lg max-w-xl mx-auto mb-10 leading-relaxed">
        Food, financial relief, and compassionate support for families in Miller &amp; Camden Counties.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/get-help" class="px-7 py-3.5 bg-white text-black font-semibold text-sm rounded-lg hover:bg-gray-100 transition-colors">
          Get Help
        </a>
        <a href="/donate" class="px-7 py-3.5 border border-white/25 text-white font-semibold text-sm rounded-lg hover:bg-white/10 transition-colors">
          Donate
        </a>
      </div>
    </div>
  </section>

  <style>
    .hero-home {
      min-height: 100vh;
    }
  </style>

  <!-- Stats -->
  <section class="border-b border-gray-100">
    <div class="max-w-5xl mx-auto px-6 py-16 grid grid-cols-2 lg:grid-cols-4 gap-10">
      <div class="text-center">
        <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">
          <span class="stat-counter" data-target={stats.individualsHelped}>0</span>+
        </p>
        <p class="text-sm text-gray-400 mt-1">Individuals helped</p>
      </div>
      <div class="text-center">
        <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">
          <span class="stat-counter" data-target={stats.pantryItemsTaken}>0</span>+
        </p>
        <p class="text-sm text-gray-400 mt-1">Pantry items given</p>
      </div>
      <div class="text-center">
        <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">
          $<span class="stat-counter" data-target={stats.donationsUsed}>0</span>
        </p>
        <p class="text-sm text-gray-400 mt-1">In direct assistance</p>
      </div>
      <div class="text-center">
        <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">24/7</p>
        <p class="text-sm text-gray-400 mt-1">Food pantry access</p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="py-24 lg:py-32">
    <div class="max-w-6xl mx-auto px-6">
      <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">What we do</p>
      <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-16 max-w-lg">
        Two ways we can help you today.
      </h2>

      <div class="grid md:grid-cols-2 gap-8">
        {siteConfig.shelter.services.map((service) => (
          <a href={service.link} class="group block">
            <div class="aspect-[16/10] rounded-xl overflow-hidden mb-5">
              <img
                src={service.image}
                alt={service.title}
                class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
              />
            </div>
            <h3 class="text-xl font-semibold text-black mb-2 group-hover:text-brand transition-colors">{service.title}</h3>
            <p class="text-gray-500 leading-relaxed mb-3">{service.description}</p>
            <span class="text-sm font-semibold text-brand">Learn more &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <PartnersSection />

  <!-- Testimonials -->
  <Testimonials />

  <!-- Mission -->
  <section class="py-24 lg:py-32 border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Our story</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight leading-tight mb-6">
            A single act of compassion became a community movement.
          </h2>
          <p class="text-gray-500 leading-relaxed mb-6">
            {siteConfig.shelter.mission.description}
          </p>
          <p class="text-gray-500 leading-relaxed mb-8">
            What began as offering shelter from the cold during a Bible study has grown into a dedicated mission serving hundreds of families across Miller and Camden Counties.
          </p>
          <a href="/about" class="text-sm font-semibold text-brand">Read our full story &rarr;</a>
        </div>
        <div class="rounded-xl overflow-hidden">
          <img
            src="https://images.squarespace-cdn.com/content/v1/53c68a2de4b0929c16dd9bf2/1623779915649-KOGVC81NLQDLR632328M/ribbon-cutting+photo+best.jpg?format=2500w"
            alt="Shelter in a Storm team"
            class="w-full"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 lg:py-32 border-t border-gray-100">
    <div class="max-w-2xl mx-auto px-6 text-center">
      <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Support our mission</p>
      <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-5">
        Every dollar goes directly to families in need.
      </h2>
      <p class="text-gray-400 leading-relaxed mb-10">
        Emergency food, utility assistance, and crisis support &mdash; funded entirely by people like you.
      </p>
      <a href="/donate" class="inline-block px-8 py-3.5 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
        Donate now
      </a>
      <p class="text-gray-300 text-xs mt-8">501(c)(3) &middot; EIN {siteConfig.shelter.ein}</p>
    </div>
  </section>
</Layout>

<script>
  function animateValue(el: HTMLElement, start: number, end: number, duration: number) {
    let startTs: number | null = null;
    const step = (ts: number) => {
      if (!startTs) startTs = ts;
      const progress = Math.min((ts - startTs) / duration, 1);
      el.innerText = Math.floor(progress * (end - start) + start).toLocaleString();
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        animateValue(el, 0, parseInt(el.dataset.target || '0'), 2000);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.2 });

  document.querySelectorAll('.stat-counter[data-target]').forEach(el => observer.observe(el));

  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (this: HTMLAnchorElement, e) {
      e.preventDefault();
      const href = this.getAttribute('href');
      if (href) document.querySelector(href)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
</script>
