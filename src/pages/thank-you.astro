---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Request Received">
  <main>
    <section class="pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="max-w-xl mx-auto px-6">

        <!-- Confirmation -->
        <div class="text-center mb-10">
          <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full border border-gray-200">
            <svg class="h-5 w-5 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
          <p class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-2">Request received</p>
          <h1 class="text-2xl lg:text-3xl font-bold text-black tracking-tight mb-3">
            We've got your request.
          </h1>
          <p class="text-sm text-gray-500 leading-relaxed">
            Your assistance request has been submitted. Our team will review it and reach out to you soon.
          </p>
        </div>

        <!-- What Happens Next -->
        <div class="rounded-xl border border-gray-200 p-5 mb-6">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-4">What happens next</p>
          <div class="space-y-4">
            <div class="flex gap-3">
              <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-black text-white text-[11px] font-semibold">1</div>
              <div>
                <p class="text-sm font-semibold text-black">Review</p>
                <p class="text-xs text-gray-500 mt-0.5">We'll review your request within 2&ndash;3 business days.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-black text-white text-[11px] font-semibold">2</div>
              <div>
                <p class="text-sm font-semibold text-black">Contact</p>
                <p class="text-xs text-gray-500 mt-0.5">We'll reach out via phone or text to discuss how we can help.</p>
              </div>
            </div>
            <div class="flex gap-3">
              <div class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-black text-white text-[11px] font-semibold">3</div>
              <div>
                <p class="text-sm font-semibold text-black">Assistance</p>
                <p class="text-xs text-gray-500 mt-0.5">We'll work together to provide the support you need.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Quick reminders -->
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 mb-8">
          <p class="text-xs text-gray-500 font-medium uppercase tracking-wide mb-3">Reminders</p>
          <ul class="space-y-2 text-sm text-gray-500">
            <li class="flex gap-2">
              <span class="text-gray-500 shrink-0">&bull;</span>
              <span>Bring a valid <strong class="text-black">photo ID</strong> and proof of residency when receiving services.</span>
            </li>
            <li class="flex gap-2">
              <span class="text-gray-500 shrink-0">&bull;</span>
              <span>We'll contact you &mdash; <strong class="text-black">no need to call us</strong> for status updates.</span>
            </li>
            <li class="flex gap-2">
              <span class="text-gray-500 shrink-0">&bull;</span>
              <span>Need food now? Our <a href="/services/food-pantry" class="text-black font-medium hover:underline">24/7 pantry</a> is always open.</span>
            </li>
          </ul>
        </div>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/" class="flex-1 inline-flex items-center justify-center px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
            Return home
          </a>
          <a href="/services/food-pantry" class="flex-1 inline-flex items-center justify-center px-6 py-3 border border-gray-200 text-black font-semibold text-sm rounded-lg hover:bg-gray-50 transition-colors">
            View food pantry
          </a>
        </div>

      </div>
    </section>
  </main>
</Layout>
