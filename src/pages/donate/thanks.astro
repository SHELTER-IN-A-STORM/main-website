---
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../config/site';
import DonorSection from '../../components/DonorSection.astro';
---

<Layout title="Thank You for Your Donation">
  <main>

    <!-- Header -->
    <section class="pt-40 pb-20 lg:pt-48 lg:pb-24">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Thank you</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-black leading-[1.1] tracking-tight mb-6" style="text-wrap: balance;">
          Your support makes a real difference.
        </h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto leading-relaxed">
          Your generous donation helps us provide vital emergency assistance and support to families in need.
        </p>
      </div>
    </section>

    <!-- Quick stats -->
    <section class="border-t border-b border-gray-100">
      <div class="max-w-4xl mx-auto px-6 py-12 grid grid-cols-1 sm:grid-cols-3 gap-8 text-center">
        <div>
          <p class="text-2xl font-bold text-black">24/7</p>
          <p class="text-sm text-gray-400 mt-1">Emergency support</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-black">100%</p>
          <p class="text-sm text-gray-400 mt-1">Goes to programs</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-black">2 counties</p>
          <p class="text-sm text-gray-400 mt-1">Served</p>
        </div>
      </div>
    </section>

    <!-- Receipt info -->
    <section class="py-24 lg:py-32">
      <div class="max-w-xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-500 leading-relaxed mb-6">
          We've sent a donation receipt to your email. For tax purposes, our EIN is {siteConfig.shelter.ein}.
        </p>
        <p class="text-sm text-gray-500 leading-relaxed mb-10">
          Questions? Contact us at
          <a href={`mailto:${siteConfig.contact.email}`} class="text-brand hover:underline font-medium">{siteConfig.contact.email}</a>.
        </p>
        <a href="/" class="inline-block px-7 py-3.5 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
          Return home
        </a>
      </div>
    </section>

    <!-- Partners -->
    <DonorSection />

  </main>
</Layout>
