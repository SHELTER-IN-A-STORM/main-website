---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Volunteer">
  <main>

    <!-- Header -->
    <section class="pt-40 pb-20 lg:pt-48 lg:pb-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Volunteer</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-black leading-[1.1] tracking-tight mb-6" style="text-wrap: balance;">
          Make a difference in your community.
        </h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto leading-relaxed">
          Join our team of volunteers helping families across Miller &amp; Camden Counties.
        </p>
      </div>
    </section>

    <!-- Opportunities -->
    <section class="pb-24 lg:pb-32">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {[
            { title: "Food Pantry Support", description: "Help organize, stock, and maintain our 24/7 emergency food pantry." },
            { title: "Community Outreach", description: "Help spread awareness and connect with those in need in our community." },
            { title: "Administrative Support", description: "Assist with office tasks, data entry, and communication with partners." },
            { title: "Special Events", description: "Help organize and run fundraising events and community gatherings." },
          ].map(opp => (
            <div class="border-t border-gray-100 pt-6">
              <h3 class="text-base font-semibold text-black mb-2">{opp.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{opp.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Requirements -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 lg:gap-20">
          <div>
            <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Getting started</p>
            <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-6">
              What to expect
            </h2>
            <p class="text-gray-500 leading-relaxed">
              We make it easy to get started. All you need is a willingness to help and a few hours each month.
            </p>
          </div>

          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-6">
            <div>
              <h3 class="text-xs text-gray-400 font-medium uppercase tracking-wide mb-4">Requirements</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="w-1 h-1 bg-black rounded-full mt-2 shrink-0"></span>
                  Must be 18 years or older
                </li>
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="w-1 h-1 bg-black rounded-full mt-2 shrink-0"></span>
                  Commit to at least 4 hours per month
                </li>
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="w-1 h-1 bg-black rounded-full mt-2 shrink-0"></span>
                  Complete volunteer orientation
                </li>
              </ul>
            </div>
            <div>
              <h3 class="text-xs text-gray-400 font-medium uppercase tracking-wide mb-4">What we provide</h3>
              <ul class="space-y-3">
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="w-1 h-1 bg-black rounded-full mt-2 shrink-0"></span>
                  Full training and orientation
                </li>
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="w-1 h-1 bg-black rounded-full mt-2 shrink-0"></span>
                  Flexible scheduling options
                </li>
                <li class="flex items-start gap-2 text-sm text-gray-600">
                  <span class="w-1 h-1 bg-black rounded-full mt-2 shrink-0"></span>
                  Supportive team environment
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Form -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-6">
        <div class="text-center mb-12">
          <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Apply</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-4">
            Ready to get started?
          </h2>
          <p class="text-gray-400 leading-relaxed">
            Fill out this form and we'll get in touch with next steps.
          </p>
        </div>

        <form
          action="https://formspree.io/f/xdkekwgj"
          method="POST"
          id="volunteer-form"
          class="space-y-5"
        >
          <div class="border border-gray-200 rounded-xl p-6 space-y-5">
            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block text-sm font-medium text-black mb-2">First Name *</label>
                <input type="text" name="First Name" required placeholder="John" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors" />
              </div>
              <div>
                <label class="block text-sm font-medium text-black mb-2">Last Name *</label>
                <input type="text" name="Last Name" required placeholder="Doe" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-medium text-black mb-2">Email *</label>
              <input type="email" name="_replyto" required placeholder="you@email.com" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors" />
            </div>

            <div>
              <label class="block text-sm font-medium text-black mb-2">Phone *</label>
              <input type="tel" name="phone" required placeholder="(555) 555-5555" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors" />
            </div>

            <div>
              <label class="block text-sm font-medium text-black mb-2">Area of interest *</label>
              <select name="interests" required class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors bg-white">
                <option value="">Select an option</option>
                <option value="food-pantry">Food Pantry Support</option>
                <option value="community-outreach">Community Outreach</option>
                <option value="administrative">Administrative Support</option>
                <option value="special-events">Special Events</option>
              </select>
            </div>

            <div>
              <label class="block text-sm font-medium text-black mb-2">Why would you like to volunteer?</label>
              <textarea name="message" rows="3" placeholder="Tell us a bit about yourself..." class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors resize-none"></textarea>
            </div>
          </div>

          <div id="form-status" class="hidden">
            <div id="vol-success" class="hidden text-center py-4 text-sm text-gray-500">
              Thanks for your submission! We'll get back to you shortly.
            </div>
            <div id="vol-error" class="hidden text-center py-4 text-sm text-red-500">
              Something went wrong. Please try again.
            </div>
          </div>

          <button type="submit" class="w-full px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
            Submit application
          </button>
        </form>
      </div>
    </section>

  </main>
</Layout>

<script>
  const form = document.getElementById('volunteer-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = document.getElementById('form-status');
    const success = document.getElementById('vol-success');
    const error = document.getElementById('vol-error');
    if (!status || !success || !error) return;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });

      if (res.ok) {
        form.reset();
        status.classList.remove('hidden');
        success.classList.remove('hidden');
        error.classList.add('hidden');
        setTimeout(() => { status.classList.add('hidden'); success.classList.add('hidden'); }, 5000);
      } else {
        throw new Error();
      }
    } catch {
      status.classList.remove('hidden');
      error.classList.remove('hidden');
      success.classList.add('hidden');
    }
  });
</script>
