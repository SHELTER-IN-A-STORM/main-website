---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import TeamMemberModal from '../components/TeamMemberModal.astro';
import DonorSection from '../components/DonorSection.astro';
import { getImpactStats } from '../lib/api';

const impactStats = await getImpactStats();
const mission = siteConfig.shelter.mission;
---

<Layout title="About Us">
  <main>

    <!-- Header -->
    <section class="pt-40 pb-20 lg:pt-48 lg:pb-24">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">About us</p>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-black leading-[1.1] tracking-tight mb-6" style="text-wrap: balance;">
          A single act of compassion became a community movement.
        </h1>
        <p class="text-gray-400 text-lg max-w-xl mx-auto leading-relaxed">
          Making a difference in Miller &amp; Camden Counties since 2021.
        </p>
      </div>
    </section>

    <!-- Origin -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div>
            <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Our beginning</p>
            <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-6">
              It started with one person on a cold night.
            </h2>
            <p class="text-gray-500 leading-relaxed mb-6">
              What began as offering shelter from the cold to a single individual during a Bible study
              has grown into a dedicated mission to serve our Lake Ozark community. Founded on February 10, 2021,
              we started with a simple goal: help those in immediate need.
            </p>
            <p class="text-gray-500 leading-relaxed">
              Through the support of our community partners and volunteers, we've expanded to provide
              24/7 emergency food assistance and connect families across Miller &amp; Camden Counties
              with vital resources.
            </p>
          </div>
          <div class="rounded-xl overflow-hidden">
            <img
              src="https://images.squarespace-cdn.com/content/v1/53c68a2de4b0929c16dd9bf2/1623779915649-KOGVC81NLQDLR632328M/ribbon-cutting+photo+best.jpg?format=2500w"
              alt="Shelter in a Storm ribbon cutting"
              class="w-full aspect-[4/3] object-cover"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Mission & Values -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-2xl mb-16">
          <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Our mission</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-6">
            Why we serve
          </h2>
          <p class="text-gray-500 leading-relaxed">
            {mission.description}
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-10">
          {mission.values.map(value => (
            <div class="border-t border-gray-100 pt-6">
              <h3 class="text-base font-semibold text-black mb-2">{value.title}</h3>
              <p class="text-sm text-gray-500 leading-relaxed">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="border-t border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-6 py-16 grid grid-cols-2 lg:grid-cols-4 gap-10">
        <div class="text-center">
          <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">
            <span class="stat-counter" data-target={impactStats.individualsHelped}>0</span>+
          </p>
          <p class="text-sm text-gray-400 mt-1">Individuals helped</p>
        </div>
        <div class="text-center">
          <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">
            <span class="stat-counter" data-target={impactStats.pantryItemsTaken}>0</span>+
          </p>
          <p class="text-sm text-gray-400 mt-1">Pantry items given</p>
        </div>
        <div class="text-center">
          <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">
            $<span class="stat-counter" data-target={impactStats.donationsUsed}>0</span>
          </p>
          <p class="text-sm text-gray-400 mt-1">In direct assistance</p>
        </div>
        <div class="text-center">
          <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">24/7</p>
          <p class="text-sm text-gray-400 mt-1">Food pantry access</p>
        </div>
      </div>
    </section>

    <!-- Team -->
    <section class="py-24 lg:py-32">
      <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-2xl mb-16">
          <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Our team</p>
          <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-6">
            The people behind the mission
          </h2>
          <p class="text-gray-500 leading-relaxed">
            Meet the dedicated individuals who make our work possible.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {siteConfig.shelter.team.map((member) => (
            <button
              type="button"
              class="group text-left cursor-pointer"
              onclick={`openTeamModal('team-modal', ${JSON.stringify(member)})`}
            >
              <div class="aspect-[4/3] rounded-xl overflow-hidden mb-4">
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500"
                />
              </div>
              <h3 class="text-base font-semibold text-black">{member.name}</h3>
              <p class="text-sm text-gray-400">{member.role}</p>
            </button>
          ))}
        </div>
      </div>
    </section>

    <TeamMemberModal id="team-modal" />

    <!-- Partners -->
    <DonorSection />

    <!-- CTA -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Support our mission</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-5">
          Every dollar goes directly to families in need.
        </h2>
        <p class="text-gray-400 leading-relaxed mb-10">
          Emergency food, utility assistance, and crisis support &mdash; funded entirely by people like you.
        </p>
        <a href="/donate" class="inline-block px-8 py-3.5 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
          Donate now
        </a>
        <p class="text-gray-300 text-xs mt-8">501(c)(3) &middot; EIN {siteConfig.shelter.ein}</p>
      </div>
    </section>

  </main>
</Layout>

<script>
  function animateValue(el: HTMLElement, start: number, end: number, duration: number) {
    let startTs: number | null = null;
    const step = (ts: number) => {
      if (!startTs) startTs = ts;
      const progress = Math.min((ts - startTs) / duration, 1);
      el.innerText = Math.floor(progress * (end - start) + start).toLocaleString();
      if (progress < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        animateValue(el, 0, parseInt(el.dataset.target || '0'), 2000);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.2 });

  document.querySelectorAll('.stat-counter[data-target]').forEach(el => observer.observe(el));
</script>
