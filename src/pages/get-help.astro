---
import Layout from '../layouts/Layout.astro';
import RequestForm from '../components/RequestForm.astro';
---

<Layout title="Get Help">
  <section class="pt-32 pb-24 lg:pt-40 lg:pb-32">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-12">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">We're here to help</p>
        <h1 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-4">
          Request assistance
        </h1>
        <p class="text-gray-400 leading-relaxed">
          Fill out this confidential form and our team will respond within 2&ndash;3 business days.
        </p>
      </div>

      <!-- Eligibility Notice -->
      <div class="mb-10 rounded-xl border border-gray-200 bg-gray-50 p-5">
        <div class="flex gap-3">
          <svg class="mt-0.5 h-5 w-5 shrink-0 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 9h3.75M15 12h3.75M15 15h3.75M4.5 19.5h15a2.25 2.25 0 0 0 2.25-2.25V6.75A2.25 2.25 0 0 0 19.5 4.5h-15A2.25 2.25 0 0 0 2.25 6.75v10.5A2.25 2.25 0 0 0 4.5 19.5Zm6-10.125a1.875 1.875 0 1 1-3.75 0 1.875 1.875 0 0 1 3.75 0Zm1.294 6.336a6.721 6.721 0 0 1-3.17.789 6.721 6.721 0 0 1-3.168-.789 3.376 3.376 0 0 1 6.338 0Z" />
          </svg>
          <div>
            <p class="text-sm font-semibold text-black">Identification &amp; Residency Requirements</p>
            <p class="mt-1 text-sm leading-relaxed text-gray-500">
              A valid <strong class="text-black">government-issued photo ID</strong> is required when receiving goods, services, or other assistance.
              You may also be asked to provide <strong class="text-black">proof of residency</strong> in Miller or Camden County (e.g., a utility bill, lease agreement, or piece of mail showing your address).
            </p>
          </div>
        </div>
      </div>

      <RequestForm showHeader={false} />

      <div class="mt-10 pt-8 border-t border-gray-100 text-center">
        <p class="text-sm text-gray-400 mb-1">Need food right now?</p>
        <a href="/services/food-pantry" class="text-sm font-semibold text-brand hover:underline">
          Visit our 24/7 food pantry &rarr;
        </a>
      </div>
    </div>
  </section>
</Layout>
