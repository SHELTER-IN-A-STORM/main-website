---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../config/site';
import DonationForm from '../components/donation/DonationForm.astro';
import { getItemsNeeded } from '../lib/api';

const neededItems = await getItemsNeeded();
---

<Layout title="Donate">
  <section class="pt-32 pb-24 lg:pt-40 lg:pb-32">
    <div class="max-w-2xl mx-auto px-6">

      <!-- Header -->
      <div class="text-center mb-12">
        <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-4">Support our mission</p>
        <h1 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-4">
          Make a donation
        </h1>
        <p class="text-gray-400 leading-relaxed">
          Your generosity helps us provide emergency food, utility assistance, and crisis support to families in need.
        </p>
      </div>

      <!-- Donation Form -->
      <DonationForm id="donate" showHeader={false} />

      <!-- Other ways -->
      <div class="mt-12 pt-8 border-t border-gray-100">
        <h3 class="text-xs text-gray-400 font-medium uppercase tracking-wide mb-6">Other ways to give</h3>
        <div class="grid sm:grid-cols-3 gap-6">
          <div>
            <p class="text-sm font-semibold text-black mb-1">Mail a check</p>
            <p class="text-sm text-gray-500 leading-relaxed">Lake Ozark Christian Church, P.O. Box 194, Lake Ozark, MO 65049</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-black mb-1">Donate items</p>
            <p class="text-sm text-gray-500 leading-relaxed">Drop off food and supplies at our <a href="/services/food-pantry" class="text-brand hover:underline">24/7 food pantry</a>.</p>
          </div>
          <div>
            <p class="text-sm font-semibold text-black mb-1">Your impact</p>
            <p class="text-sm text-gray-500 leading-relaxed">$25 feeds a family for a week. $100 covers emergency housing assistance.</p>
          </div>
        </div>
      </div>

      <!-- Needed items -->
      {neededItems.length > 0 && (
        <div class="mt-8 pt-8 border-t border-gray-100">
          <h3 class="text-xs text-gray-400 font-medium uppercase tracking-wide mb-4">Most needed items this month</h3>
          <div class="flex flex-wrap gap-2">
            {neededItems.map((item: string) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1.5 border border-gray-200 text-sm text-gray-600 rounded-full">
                <span class="w-1 h-1 bg-black rounded-full"></span>
                {item}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Tax info -->
      <div class="mt-8 pt-8 border-t border-gray-100 text-center">
        <p class="text-xs text-gray-400">
          Shelter in a Storm is a 501(c)(3) organization. EIN: {siteConfig.shelter.ein}. All donations are tax-deductible.
        </p>
      </div>

    </div>
  </section>
</Layout>
