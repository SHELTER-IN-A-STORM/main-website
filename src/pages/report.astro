---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Report an Issue">
  <main>
    <section class="pt-32 pb-16 lg:pt-40 lg:pb-20">
      <div class="max-w-2xl mx-auto px-6">

        <!-- Header -->
        <div class="text-center mb-10">
          <p class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-2">Feedback</p>
          <h1 class="text-2xl lg:text-3xl font-bold text-black tracking-tight mb-3">
            Report an issue
          </h1>
          <p class="text-sm text-gray-400 leading-relaxed">
            Help us improve by reporting bugs, content errors, or accessibility issues with our website.
          </p>
        </div>

        <!-- Not looking for help? -->
        <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 mb-8">
          <div class="flex gap-3">
            <svg class="mt-0.5 h-5 w-5 shrink-0 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
            </svg>
            <div>
              <p class="text-sm font-semibold text-black">Need help or assistance?</p>
              <p class="mt-1 text-sm leading-relaxed text-gray-500">
                This form is for reporting <strong class="text-black">technical issues</strong> with our website. If you need help with food, housing, or other services, visit our help page instead.
              </p>
              <a href="/get-help" class="mt-2 inline-block text-sm font-semibold text-black hover:underline">
                Get help &rarr;
              </a>
            </div>
          </div>
        </div>

        <!-- Report Form -->
        <form
          action="https://formspree.io/f/xanenpoz"
          method="POST"
          id="report-form"
          class="space-y-5"
        >
          <div>
            <label class="block text-sm font-medium text-black mb-2" for="issue-type">Issue Type *</label>
            <select
              id="issue-type"
              name="Issue Type"
              required
              class="form-field"
            >
              <option value="">Select an issue type</option>
              <option value="security">Security Concern</option>
              <option value="bug">Website Bug</option>
              <option value="content">Content Error</option>
              <option value="accessibility">Accessibility Issue</option>
              <option value="other">Other</option>
            </select>
          </div>

          <!-- Security notice -->
          <div id="security-notice" class="hidden rounded-xl border border-gray-200 bg-gray-50 p-5">
            <p class="text-sm font-semibold text-black mb-2">Security concerns require direct contact</p>
            <p class="text-sm text-gray-500 leading-relaxed mb-3">
              For security-related issues, please email us directly. Include "URGENT" in your subject line.
            </p>
            <div class="space-y-1.5 text-sm">
              <a href="mailto:compliance@donork.it?subject=URGENT: Security Concern" class="block text-black font-medium hover:underline">compliance@donork.it</a>
              <a href="mailto:security@shelterinastorm.org?subject=URGENT: Security Concern" class="block text-black font-medium hover:underline">security@shelterinastorm.org</a>
              <a href="mailto:ben@shelterinastorm.org?subject=URGENT: Security Concern" class="block text-black font-medium hover:underline">ben@shelterinastorm.org</a>
            </div>
          </div>

          <div id="regular-form-fields">
            <div class="space-y-5">
              <div>
                <label class="block text-sm font-medium text-black mb-2" for="page-url">Page URL *</label>
                <input
                  type="url"
                  id="page-url"
                  name="Page URL"
                  placeholder="https://shelterinastorm.org/..."
                  required
                  class="form-field"
                />
              </div>

              <div>
                <label class="block text-sm font-medium text-black mb-2" for="description">Description *</label>
                <textarea
                  id="description"
                  name="Description"
                  rows="4"
                  required
                  placeholder="Please describe the issue in detail..."
                  class="form-field resize-none"
                ></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-black mb-2" for="email">Your Email (optional)</label>
                <input
                  type="email"
                  id="email"
                  name="_replyto"
                  placeholder="For follow-up questions"
                  class="form-field"
                />
              </div>
            </div>
          </div>

          <!-- Status messages -->
          <div id="form-status" class="hidden">
            <div id="success" class="hidden rounded-lg border border-gray-200 bg-gray-50 p-4 text-center text-sm text-gray-500">
              Thanks for your report! We'll look into it.
            </div>
            <div id="error" class="hidden rounded-lg border border-gray-200 bg-gray-50 p-4 text-center text-sm text-gray-500">
              There was a problem submitting your report. Please try again.
            </div>
          </div>

          <button
            type="submit"
            class="w-full px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors"
          >
            Submit Report
          </button>
        </form>

        <!-- Response times & compliance -->
        <div class="mt-8 space-y-4">
          <div class="rounded-xl border border-gray-200 p-5">
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide mb-3">Response times</p>
            <ul class="space-y-2 text-sm text-gray-500">
              <li class="flex gap-2">
                <span class="text-gray-400 shrink-0">&bull;</span>
                <span><strong class="text-black">Bug reports:</strong> Acknowledged within 24&ndash;48 hours</span>
              </li>
              <li class="flex gap-2">
                <span class="text-gray-400 shrink-0">&bull;</span>
                <span><strong class="text-black">Compliance issues:</strong> Response within 1 business day</span>
              </li>
              <li class="flex gap-2">
                <span class="text-gray-400 shrink-0">&bull;</span>
                <span><strong class="text-black">General inquiries:</strong> 2&ndash;3 business days</span>
              </li>
            </ul>
          </div>

          <div class="rounded-xl border border-gray-200 bg-gray-50 p-5">
            <p class="text-xs text-gray-400 font-medium uppercase tracking-wide mb-2">Compliance contact</p>
            <p class="text-sm text-gray-500 mb-2">For urgent or compliance-related matters, contact us directly:</p>
            <a href="mailto:compliance@donork.it" class="text-sm text-black font-medium hover:underline">compliance@donork.it</a>
          </div>
        </div>

      </div>
    </section>
  </main>
</Layout>

<style>
  .form-field {
    width: 100%;
    padding: 0.625rem 0.875rem;
    border: 1px solid #e5e7eb;
    border-radius: 0.5rem;
    background: white;
    font-size: 0.875rem;
    color: #111;
    transition: border-color 0.15s ease;
  }
  .form-field::placeholder {
    color: #d1d5db;
  }
  .form-field:focus {
    outline: none;
    border-color: #111;
    box-shadow: 0 0 0 1px #111;
  }
</style>

<script>
  declare global {
    function trackEvent(category: string, action: string, label?: string): void;
  }

  const form = document.getElementById("report-form") as HTMLFormElement;
  const issueType = document.getElementById("issue-type") as HTMLSelectElement;
  const securityNotice = document.getElementById("security-notice");
  const regularFormFields = document.getElementById("regular-form-fields");

  issueType?.addEventListener("change", (e) => {
    const target = e.target as HTMLSelectElement;
    if (target.value === "security") {
      securityNotice?.classList.remove("hidden");
      regularFormFields?.classList.add("hidden");
      if (typeof trackEvent === 'function') trackEvent('Report Page', 'Security Option', 'Selected');
    } else {
      securityNotice?.classList.add("hidden");
      regularFormFields?.classList.remove("hidden");
    }
  });

  async function handleSubmit(event: SubmitEvent) {
    event.preventDefault();
    const status = document.getElementById("form-status");
    const success = document.getElementById("success");
    const error = document.getElementById("error");

    if (!form || !status || !success || !error) return;

    try {
      const response = await fetch((event.target as HTMLFormElement).action, {
        method: form.method,
        body: new FormData(event.target as HTMLFormElement),
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        form.reset();
        status.classList.remove("hidden");
        success.classList.remove("hidden");
        error.classList.add("hidden");
        if (typeof trackEvent === 'function') trackEvent('Report Page', 'Form', 'Submission Success');
        setTimeout(() => {
          status.classList.add("hidden");
          success.classList.add("hidden");
        }, 5000);
      } else {
        const data = await response.json();
        if (Object.hasOwn(data, 'errors')) {
          status.classList.remove("hidden");
          error.classList.remove("hidden");
          success.classList.add("hidden");
          error.innerHTML = data.errors.map((e: { message: string }) => e.message).join(", ");
        } else {
          throw new Error("Form submission failed");
        }
      }
    } catch (err) {
      status.classList.remove("hidden");
      error.classList.remove("hidden");
      success.classList.add("hidden");
      error.innerHTML = "There was a problem submitting your report. Please try again.";
      if (typeof trackEvent === 'function') trackEvent('Report Page', 'Form', 'Submission Error');
    }
  }

  if (form) {
    form.addEventListener("submit", handleSubmit);
  }

  const pageUrlInput = document.getElementById('page-url') as HTMLInputElement;
  if (pageUrlInput && document.referrer) {
    pageUrlInput.value = document.referrer;
  }
</script>
