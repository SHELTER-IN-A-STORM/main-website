---
import Layout from './Layout.astro';
import EventGallery from '../components/events/EventGallery.astro';
import { format } from 'date-fns';

const { frontmatter } = Astro.props;
const isPast = frontmatter.status === 'past';
const eventDate = new Date(frontmatter.date);
const day = format(eventDate, 'd');
const month = format(eventDate, 'MMM').toUpperCase();
const fullDate = format(eventDate, 'EEEE, MMMM d, yyyy');
---

<Layout title={frontmatter.title}>
  <article>

    <!-- Hero -->
    <section class="relative flex items-end overflow-hidden event-hero">
      <div class="absolute inset-0">
        <img
          src={frontmatter.image}
          alt={frontmatter.title}
          class="w-full h-full object-cover"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-black/20"></div>
      </div>
      <div class="relative w-full max-w-5xl mx-auto px-6 pb-16 pt-40 lg:pb-20 lg:pt-48">
        <a href="/events" class="inline-flex items-center text-sm text-white/80 hover:text-white transition-colors mb-8">
          <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
          All events
        </a>

        <div class="flex items-start gap-6">
          <!-- Date block -->
          <div class="hidden md:flex flex-col items-center bg-white rounded-xl px-4 py-3 min-w-[72px] shrink-0">
            <span class="text-xs font-semibold text-gray-500 uppercase tracking-wider">{month}</span>
            <span class="text-3xl font-bold text-black leading-none">{day}</span>
          </div>

          <div>
            {isPast && (
              <span class="inline-block text-xs font-medium uppercase tracking-wider text-white/40 mb-3">Past event</span>
            )}
            <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-[1.1] tracking-tight mb-4" style="text-wrap: balance;">
              {frontmatter.title}
            </h1>
            <p class="text-white/80 text-base leading-relaxed max-w-2xl">
              {frontmatter.description}
            </p>
          </div>
        </div>
      </div>
    </section>

    <style>
      .event-hero { min-height: 60vh; }
    </style>

    <!-- Details Bar -->
    <section class="border-b border-gray-100">
      <div class="max-w-5xl mx-auto px-6 py-5 flex flex-wrap gap-x-10 gap-y-3 text-sm">
        <div class="flex items-center gap-2 text-gray-500">
          <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          {fullDate}
        </div>
        {frontmatter.time && (
          <div class="flex items-center gap-2 text-gray-500">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {frontmatter.time}
          </div>
        )}
        {frontmatter.location && (
          <div class="flex items-center gap-2 text-gray-500">
            <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            {frontmatter.location}
          </div>
        )}
        {frontmatter.ticketLink && !isPast && (
          <a
            href={frontmatter.ticketLink}
            class="ml-auto px-5 py-2 bg-black text-white text-sm font-semibold rounded-lg hover:bg-gray-900 transition-colors"
          >
            {frontmatter.ticketPrice > 0 ? `Get Tickets · $${frontmatter.ticketPrice}` : 'Register Free'}
          </a>
        )}
      </div>
    </section>

    <!-- Stats -->
    {frontmatter.stats && (
      <section class="border-b border-gray-100">
        <div class="max-w-5xl mx-auto px-6 py-14 grid grid-cols-2 md:grid-cols-{frontmatter.stats.length} gap-8">
          {frontmatter.stats.map((stat: { value: string; label: string }) => (
            <div class="text-center">
              <p class="text-3xl lg:text-4xl font-bold text-black tracking-tight">{stat.value}</p>
              <p class="text-sm text-gray-500 mt-1">{stat.label}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Content -->
    <section class="py-16 lg:py-24">
      <div class="max-w-3xl mx-auto px-6">
        <div class="prose prose-lg prose-gray max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-h2:text-xl prose-h2:mt-12 prose-h2:mb-4 prose-h3:text-base prose-h3:mt-8 prose-h3:mb-3 prose-p:text-gray-500 prose-p:leading-relaxed prose-li:text-gray-500 prose-strong:text-black prose-a:text-black prose-a:underline prose-a:decoration-gray-300 hover:prose-a:decoration-black prose-img:rounded-xl prose-hr:border-gray-100">
          <slot />
        </div>
      </div>
    </section>

    <!-- Gallery -->
    {frontmatter.gallery && frontmatter.gallery.length > 0 && (
      <section class="pb-24 lg:pb-32 border-t border-gray-100 pt-16 lg:pt-24">
        <div class="max-w-5xl mx-auto px-6">
          <p class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-4">Gallery</p>
          <h2 class="text-2xl font-bold text-black tracking-tight mb-8">Photos from the event</h2>
          <EventGallery images={frontmatter.gallery} />
        </div>
      </section>
    )}

    <!-- CTA -->
    <section class="py-24 lg:py-32 border-t border-gray-100">
      <div class="max-w-2xl mx-auto px-6 text-center">
        <p class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-4">Support our mission</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight mb-5">
          Events like this are made possible by you.
        </h2>
        <p class="text-gray-500 leading-relaxed mb-10">
          Your donation directly funds community events, emergency food, and crisis support.
        </p>
        <div class="flex flex-wrap gap-3 justify-center">
          <a href="/donate" class="px-7 py-3.5 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors">
            Donate
          </a>
          <a href="/events" class="px-7 py-3.5 border border-gray-200 text-black font-semibold text-sm rounded-lg hover:border-gray-300 transition-colors">
            View all events
          </a>
        </div>
      </div>
    </section>

  </article>
</Layout>
