---
interface Props {
    id?: string;
}

const { id = 'event-alert' } = Astro.props;
---

<!-- Desktop Version -->
<div 
    id={id}
    class="fixed bottom-6 left-6 max-w-sm w-full transform -translate-x-[150%] transition-all duration-500 ease-in-out z-40 hidden md:block"
>
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm">
        <div id={`${id}-image`} class="relative h-32">
            <img src="" alt="" class="w-full h-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
            <div class="absolute top-3 left-3">
                <span id={`${id}-badge`} class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-white text-black shadow-sm">
                    Upcoming Event
                </span>
            </div>
            <button
                type="button"
                aria-label="Dismiss event alert"
                onclick={`document.getElementById('${id}').style.transform = 'translateX(-150%)'`}
                class="absolute top-3 right-3 p-1.5 rounded-full bg-black/20 hover:bg-black/40 transition-colors"
            >
                <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>

        <div class="p-4 space-y-3">
            <div>
                <h3 id={`${id}-title`} class="text-base font-semibold text-black"></h3>
                <p id={`${id}-description`} class="mt-1 text-sm text-gray-500 line-clamp-2"></p>
            </div>
            <a
                id={`${id}-action`}
                href="#"
                class="inline-flex w-full items-center justify-center px-4 py-2.5 bg-black text-white text-sm font-semibold rounded-lg hover:bg-gray-900 transition-colors"
            >
                <span>Learn More</span>
            </a>
        </div>
    </div>
</div>

<!-- Mobile Version -->
<div 
    id={`${id}-mobile`}
    class="fixed bottom-0 left-0 right-0 transform translate-y-full transition-all duration-500 ease-in-out z-40 md:hidden"
>
    <div class="bg-white border-t border-gray-200">
        <div class="flex items-center p-4 gap-3">
            <div id={`${id}-mobile-image`} class="w-16 h-16 rounded-xl overflow-hidden flex-shrink-0">
                <img src="" alt="" class="w-full h-full object-cover" />
            </div>
            <div class="flex-grow min-w-0">
                <span id={`${id}-mobile-badge`} class="text-[10px] font-medium uppercase tracking-wide text-gray-500">Upcoming Event</span>
                <h3 id={`${id}-mobile-title`} class="text-sm font-semibold text-black truncate"></h3>
                <p id={`${id}-mobile-description`} class="text-xs text-gray-500 truncate"></p>
            </div>
            <button
                type="button"
                aria-label="Dismiss event alert"
                onclick={`document.getElementById('${id}-mobile').style.transform = 'translateY(100%)'`}
                class="p-2 hover:bg-gray-50 rounded-lg transition-colors shrink-0"
            >
                <svg class="w-4 h-4 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </button>
        </div>
        <a
            id={`${id}-mobile-action`}
            href="#"
            class="block w-full py-3.5 px-5 bg-black text-white text-center text-sm font-semibold"
        >
            Learn More
        </a>
    </div>
</div>

<!-- Off-site Warning Modal -->
<div id={`${id}-warning-modal`} class="fixed inset-0 bg-black/40 hidden z-50 backdrop-blur-sm">
    <div class="fixed inset-0 flex items-center justify-center p-4">
        <div class="bg-white rounded-xl max-w-sm w-full border border-gray-200">
            <div class="p-6 space-y-4">
                <div class="flex items-start justify-between">
                    <h3 class="text-lg font-semibold text-black">Leaving our site</h3>
                    <button 
                        onclick={`document.getElementById('${id}-warning-modal').classList.add('hidden')`}
                        class="p-1 hover:bg-gray-50 rounded-lg transition-colors"
                    >
                        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                        </svg>
                    </button>
                </div>
                <p class="text-sm text-gray-500">You're about to visit an external website with different terms and privacy policies.</p>
                <div class="flex gap-2">
                    <button
                        onclick={`document.getElementById('${id}-warning-modal').classList.add('hidden')`}
                        class="flex-1 px-4 py-2.5 border border-gray-200 text-black text-sm font-semibold rounded-lg hover:border-gray-300 transition-colors"
                    >
                        Go Back
                    </button>
                    <a
                        id={`${id}-external-link`}
                        href="#"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex-1 inline-flex items-center justify-center px-4 py-2.5 bg-black text-white text-sm font-semibold rounded-lg hover:bg-gray-900 transition-colors"
                    >
                        Continue
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Warning Modal -->
<div id={`${id}-warning-modal-mobile`} class="fixed inset-0 bg-black/40 hidden z-50 backdrop-blur-sm md:hidden">
    <div class="fixed bottom-0 left-0 right-0 bg-white rounded-t-xl">
        <div class="p-5 space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-base font-semibold text-black">Leaving our site</h3>
                <button 
                    onclick={`document.getElementById('${id}-warning-modal-mobile').classList.add('hidden')`}
                    class="p-1 hover:bg-gray-50 rounded-lg transition-colors"
                >
                    <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <p class="text-sm text-gray-500">You're about to visit an external website with different terms and privacy policies.</p>
            <div class="flex gap-2">
                <button
                    onclick={`document.getElementById('${id}-warning-modal-mobile').classList.add('hidden')`}
                    class="flex-1 px-4 py-3 border border-gray-200 text-black text-sm font-semibold rounded-lg"
                >
                    Go Back
                </button>
                <a
                    id={`${id}-external-link-mobile`}
                    href="#"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex-1 inline-flex items-center justify-center px-4 py-3 bg-black text-white text-sm font-semibold rounded-lg"
                >
                    Continue
                </a>
            </div>
        </div>
    </div>
</div>

<script define:vars={{ id }}>
    window.showEventAlert = function({ title, description, image, badge = 'Upcoming Event', actionText = 'Learn More', actionUrl = '#', isExternalLink = false }) {
        const alert = document.getElementById(id);
        const titleEl = document.getElementById(`${id}-title`);
        const descriptionEl = document.getElementById(`${id}-description`);
        const badgeEl = document.getElementById(`${id}-badge`);
        const actionEl = document.getElementById(`${id}-action`);
        const imageEl = document.querySelector(`#${id}-image img`);
        const externalLinkEl = document.getElementById(`${id}-external-link`);
        
        const mobileAlert = document.getElementById(`${id}-mobile`);
        const mobileTitleEl = document.getElementById(`${id}-mobile-title`);
        const mobileDescriptionEl = document.getElementById(`${id}-mobile-description`);
        const mobileBadgeEl = document.getElementById(`${id}-mobile-badge`);
        const mobileActionEl = document.getElementById(`${id}-mobile-action`);
        const mobileImageEl = document.querySelector(`#${id}-mobile-image img`);
        const mobileExternalLinkEl = document.getElementById(`${id}-external-link-mobile`);
        
        if (alert && titleEl && descriptionEl && badgeEl && actionEl && imageEl && externalLinkEl) {
            titleEl.textContent = title;
            descriptionEl.textContent = description;
            badgeEl.textContent = badge;
            const actionSpan = actionEl.querySelector('span');
            if (actionSpan) actionSpan.textContent = actionText;
            if (isExternalLink) {
                actionEl.addEventListener('click', (e) => { e.preventDefault(); document.getElementById(`${id}-warning-modal`).classList.remove('hidden'); });
                externalLinkEl.href = actionUrl;
            } else {
                actionEl.href = actionUrl;
                actionEl.replaceWith(actionEl.cloneNode(true));
            }
            imageEl.src = image;
            imageEl.alt = title;
            alert.style.transform = 'translateX(0)';
        }
        
        if (mobileAlert && mobileTitleEl && mobileDescriptionEl && mobileBadgeEl && mobileActionEl && mobileImageEl && mobileExternalLinkEl) {
            mobileTitleEl.textContent = title;
            mobileDescriptionEl.textContent = description;
            mobileBadgeEl.textContent = badge;
            const mobileActionSpan = mobileActionEl.querySelector('span');
            if (mobileActionSpan) mobileActionSpan.textContent = actionText;
            if (isExternalLink) {
                mobileActionEl.addEventListener('click', (e) => { e.preventDefault(); document.getElementById(`${id}-warning-modal-mobile`).classList.remove('hidden'); });
                mobileExternalLinkEl.href = actionUrl;
            } else {
                mobileActionEl.href = actionUrl;
                mobileActionEl.replaceWith(mobileActionEl.cloneNode(true));
            }
            mobileImageEl.src = image;
            mobileImageEl.alt = title;
            mobileAlert.style.transform = 'translateY(0)';
        }
    }
</script>
