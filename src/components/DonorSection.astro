---
import DonorScroll from './DonorScroll.astro';
---

<section class="py-20 border-t border-gray-100">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
      <div>
        <p class="text-sm text-gray-500 font-medium uppercase tracking-wide mb-4">Our donors</p>
        <h2 class="text-3xl lg:text-4xl font-bold text-black tracking-tight max-w-md">
          Made possible by our community.
        </h2>
      </div>
    </div>
    <DonorScroll />
  </div>
</section>
