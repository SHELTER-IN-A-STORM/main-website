<div 
    id="cookie-consent" 
    class="fixed bottom-6 left-1/2 -translate-x-1/2 w-full max-w-md mx-auto bg-white rounded-xl border border-gray-200 shadow-lg transform translate-y-[200%] transition-all duration-500 z-50 px-4 invisible opacity-0"
    role="dialog"
    aria-labelledby="cookie-title"
    aria-describedby="cookie-description"
>
    <div class="p-5">
        <div class="flex justify-between items-start mb-3">
            <h3 id="cookie-title" class="text-sm font-semibold text-black">Cookie Settings</h3>
            <button
                id="close-consent"
                type="button"
                class="text-gray-600 hover:text-black transition-colors"
                aria-label="Close cookie settings"
            >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        
        <p id="cookie-description" class="text-sm text-gray-500 mb-5">
            We use cookies to enhance your experience.
        </p>

        <div class="space-y-3 mb-5">
            <div class="flex items-center justify-between py-2">
                <div>
                    <p class="text-sm font-medium text-black" id="essential-label">Essential</p>
                    <p class="text-xs text-gray-500">Required for the site to function</p>
                </div>
                <input type="checkbox" id="essential-cookies" checked disabled class="h-4 w-4 accent-black rounded cursor-not-allowed" aria-labelledby="essential-label" />
            </div>
            <div class="flex items-center justify-between py-2 border-t border-gray-100">
                <div>
                    <p class="text-sm font-medium text-black" id="analytics-label">Analytics</p>
                    <p class="text-xs text-gray-500">Help us improve</p>
                </div>
                <input type="checkbox" id="analytics-cookies" class="h-4 w-4 accent-black rounded cursor-pointer" aria-labelledby="analytics-label" />
            </div>
        </div>

        <div class="flex gap-2">
            <button id="accept-all" class="flex-1 px-4 py-2.5 bg-black text-white text-sm font-semibold rounded-lg hover:bg-gray-900 transition-colors" type="button">
                Accept All
            </button>
            <button id="save-preferences" class="flex-1 px-4 py-2.5 border border-gray-200 text-black text-sm font-semibold rounded-lg hover:border-gray-300 transition-colors" type="button">
                Save
            </button>
        </div>

        <div class="mt-3 text-center">
            <a href="/legal/privacy" class="text-xs text-gray-500 hover:text-black hover:underline">Privacy Policy</a>
        </div>
    </div>
</div>

<script>
    declare global {
        interface Window {
            showCookieConsent: () => void;
        }
    }

    import { trackEvent, handleCookieConsent, loadAnalytics } from '../utils/analytics';
    
    loadAnalytics();
    
    const cookieConsent = document.getElementById('cookie-consent');
    const acceptAllBtn = document.getElementById('accept-all');
    const savePreferencesBtn = document.getElementById('save-preferences');
    const closeConsentBtn = document.getElementById('close-consent');
    const analyticsCheckbox = document.getElementById('analytics-cookies') as HTMLInputElement;

    function showCookieConsent() {
        if (cookieConsent) {
            cookieConsent.classList.remove('translate-y-[200%]', 'invisible', 'opacity-0');
            cookieConsent.classList.add('translate-y-0', 'visible', 'opacity-100');
        }
    }

    function hideCookieConsent() {
        if (cookieConsent) {
            cookieConsent.classList.add('translate-y-[200%]', 'invisible', 'opacity-0');
            cookieConsent.classList.remove('translate-y-0', 'visible', 'opacity-100');
        }
    }

    const hasConsent = localStorage.getItem('cookie-consent');
    if (!hasConsent) {
        setTimeout(showCookieConsent, 1000);
    }

    const savedPreferences = localStorage.getItem('cookiePreferences');
    if (savedPreferences) {
        const preferences = JSON.parse(savedPreferences);
        if (analyticsCheckbox) analyticsCheckbox.checked = preferences.analytics;
    }

    function saveConsent(analytics: boolean, action: 'accept' | 'reject' | 'dismiss') {
        handleCookieConsent(action);
        localStorage.setItem('cookiePreferences', JSON.stringify({ essential: true, analytics }));
        trackEvent('Cookie Consent', 'Click', analytics ? 'Accept All' : 'Custom Preferences');
        hideCookieConsent();
    }

    acceptAllBtn?.addEventListener('click', () => { trackEvent('Cookie Consent', 'Click', 'Accept All'); saveConsent(true, 'accept'); });
    savePreferencesBtn?.addEventListener('click', () => { trackEvent('Cookie Consent', 'Click', 'Save Preferences'); saveConsent(analyticsCheckbox?.checked || false, analyticsCheckbox?.checked ? 'accept' : 'reject'); });
    closeConsentBtn?.addEventListener('click', () => { trackEvent('Cookie Consent', 'Click', 'Close'); saveConsent(true, 'dismiss'); hideCookieConsent(); });
    analyticsCheckbox?.addEventListener('change', (e) => { trackEvent('Cookie Consent', 'Toggle Analytics', (e.target as HTMLInputElement).checked ? 'Enabled' : 'Disabled'); });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && cookieConsent && !cookieConsent.classList.contains('invisible')) {
            trackEvent('Cookie Consent', 'Keyboard', 'Escape');
            saveConsent(true, 'dismiss');
        }
    });

    window.showCookieConsent = showCookieConsent;
</script>
