---
interface Props {
  id?: string;
  showHeader?: boolean;
}

const { id = 'donation', showHeader = true } = Astro.props;
const formId = `${id}-form`;
const prefix = id;
---

<div>
  {showHeader && (
    <div class="mb-6">
      <h3 class="text-lg font-semibold text-black">Make a Donation</h3>
    </div>
  )}

  <form id={formId} class="space-y-5" data-prefix={prefix}>
    <div class="border border-gray-200 rounded-xl p-6 space-y-5">

      <!-- Gift Type -->
      <div>
        <label class="block text-sm font-medium text-black mb-2">Gift type</label>
        <div class="grid grid-cols-2 gap-3">
          <label class="relative cursor-pointer">
            <input type="radio" name="donationType" value="one-time" class="peer sr-only" checked />
            <div class="px-4 py-3 border border-gray-200 bg-white text-center rounded-lg peer-checked:border-black peer-checked:bg-black peer-checked:text-white transition-all">
              <span class="font-medium text-sm">One-Time</span>
            </div>
          </label>
          <label class="relative cursor-pointer">
            <input type="radio" name="donationType" value="recurring" class="peer sr-only" />
            <div class="px-4 py-3 border border-gray-200 bg-white text-center rounded-lg peer-checked:border-black peer-checked:bg-black peer-checked:text-white transition-all">
              <span class="font-medium text-sm">Recurring</span>
            </div>
          </label>
        </div>
      </div>

      <!-- Frequency -->
      <div class="frequency-selection hidden" data-field="frequency">
        <label class="block text-sm font-medium text-black mb-2">Frequency</label>
        <select
          name="frequency"
          class="frequency-select w-full px-4 py-2.5 border border-gray-200 rounded-lg bg-white text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
        >
          <option value="weekly">Weekly</option>
          <option value="biweekly">Bi-weekly</option>
          <option value="monthly" selected>Monthly</option>
          <option value="yearly">Annually</option>
        </select>
      </div>

      <!-- Amount -->
      <div>
        <label class="block text-sm font-medium text-black mb-2">Amount</label>
        <div class="grid grid-cols-4 gap-2 mb-3">
          <button type="button" class="amount-btn py-2.5 border border-gray-200 rounded-lg bg-white font-medium text-sm text-gray-600 hover:border-gray-400 transition-all" data-amount="25">$25</button>
          <button type="button" class="amount-btn py-2.5 border border-black rounded-lg bg-black font-medium text-sm text-white selected" data-amount="50">$50</button>
          <button type="button" class="amount-btn py-2.5 border border-gray-200 rounded-lg bg-white font-medium text-sm text-gray-600 hover:border-gray-400 transition-all" data-amount="100">$100</button>
          <button type="button" class="amount-btn py-2.5 border border-gray-200 rounded-lg bg-white font-medium text-sm text-gray-600 hover:border-gray-400 transition-all" data-amount="250">$250</button>
        </div>
        <div class="relative">
          <span class="absolute left-4 top-1/2 transform -translate-y-1/2 text-gray-400 text-sm">$</span>
          <input
            type="number"
            name="amount"
            class="custom-amount w-full pl-8 pr-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
            min="5"
            max="999999"
            step="0.01"
            value="50"
            placeholder="Enter amount"
          />
        </div>
      </div>

      <!-- Email -->
      <div>
        <label class="block text-sm font-medium text-black mb-2">Email *</label>
        <input
          type="email"
          name="email"
          required
          placeholder="you@email.com"
          class="email-input w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
        />
        <p class="text-xs text-gray-400 mt-1">We'll send your receipt here.</p>
      </div>

      <!-- Cover Fees -->
      <div class="flex items-start gap-3 pt-4 border-t border-gray-100">
        <input
          type="checkbox"
          name="coverFees"
          class="cover-fees mt-0.5 h-4 w-4 rounded border-gray-300 accent-black cursor-pointer"
        />
        <label class="cursor-pointer cover-fees-label flex-1">
          <span class="text-sm font-medium text-black">Cover transaction fees</span>
          <span class="block text-xs text-gray-400">Add <span class="fee-amount">$1.75</span> so we receive your full donation.</span>
        </label>
      </div>
    </div>

    <!-- Disclaimer -->
    <div class="donation-disclaimer text-xs text-gray-400 leading-relaxed text-center">
      By clicking "Complete Donation", you authorize Shelter in a Storm to charge <strong class="text-gray-600 disclaimer-amount">$50.00</strong><span class="recurring-text" style="display:none;"> <strong class="text-gray-600 disclaimer-frequency">every month</strong> until cancelled</span>.
      <a href="/legal/terms" class="text-black hover:underline">Terms</a> &middot;
      <a href="/legal/privacy" class="text-black hover:underline">Privacy</a>
    </div>

    <!-- Inline Error -->
    <div class="form-error hidden text-sm text-red-500 text-center py-2"></div>

    <!-- Submit -->
    <button
      type="submit"
      class="donate-btn w-full px-6 py-3 bg-black text-white font-semibold text-sm rounded-lg hover:bg-gray-900 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
    >
      <span class="btn-text">Complete Donation</span>
      <span class="btn-loading hidden">Processing...</span>
    </button>

    <p class="text-center text-xs text-gray-300">Secure donation powered by Stripe</p>
  </form>
</div>

<style>
  .amount-btn.selected {
    border-color: #000;
    background-color: #000;
    color: #fff;
  }
  .custom-amount::-webkit-inner-spin-button,
  .custom-amount::-webkit-outer-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .custom-amount { -moz-appearance: textfield; }
</style>

<script>
  function initDonationForms() {
    document.querySelectorAll('form[data-prefix]').forEach(form => {
      initDonationForm(form as HTMLFormElement);
    });
  }

  function initDonationForm(form: HTMLFormElement) {
    function calcFee(amount: number) {
      return Math.round((amount * 0.029 + 0.30) * 100) / 100;
    }

    const amountInput = form.querySelector('.custom-amount') as HTMLInputElement;
    const frequencySelect = form.querySelector('.frequency-select') as HTMLSelectElement;
    const frequencyDiv = form.querySelector('.frequency-selection') as HTMLElement;
    const coverFeesCheckbox = form.querySelector('.cover-fees') as HTMLInputElement;
    const coverFeesLabel = form.querySelector('.cover-fees-label') as HTMLElement;
    const feeAmountSpan = form.querySelector('.fee-amount') as HTMLElement;
    const disclaimerAmount = form.querySelector('.disclaimer-amount') as HTMLElement;
    const disclaimerFrequency = form.querySelector('.disclaimer-frequency') as HTMLElement;
    const recurringText = form.querySelector('.recurring-text') as HTMLElement;
    const donateBtn = form.querySelector('.donate-btn') as HTMLButtonElement;
    const btnText = form.querySelector('.btn-text') as HTMLElement;
    const btnLoading = form.querySelector('.btn-loading') as HTMLElement;
    const amountBtns = form.querySelectorAll('.amount-btn');

    function update() {
      const amount = parseFloat(amountInput?.value || '50') || 50;
      const isRecurring = (form.querySelector('input[name="donationType"]:checked') as HTMLInputElement)?.value === 'recurring';
      const coverFees = coverFeesCheckbox?.checked || false;

      if (feeAmountSpan) feeAmountSpan.textContent = `$${calcFee(amount).toFixed(2)}`;
      if (frequencyDiv) frequencyDiv.classList.toggle('hidden', !isRecurring);

      let total = amount;
      if (coverFees) total += calcFee(amount);
      if (disclaimerAmount) disclaimerAmount.textContent = `$${total.toFixed(2)}`;

      if (isRecurring) {
        if (disclaimerFrequency) {
          const map: Record<string, string> = { weekly: 'every week', biweekly: 'every 2 weeks', monthly: 'every month', yearly: 'every year' };
          disclaimerFrequency.textContent = map[frequencySelect?.value || 'monthly'] || 'every month';
        }
        if (recurringText) recurringText.style.display = 'inline';
      } else {
        if (recurringText) recurringText.style.display = 'none';
      }
    }

    amountBtns.forEach(btn => {
      btn.addEventListener('click', function(this: HTMLElement) {
        const amt = this.dataset.amount;
        if (!amt) return;
        if (amountInput) amountInput.value = amt;
        amountBtns.forEach(b => {
          b.classList.remove('border-black', 'bg-black', 'text-white', 'selected');
          b.classList.add('border-gray-200', 'text-gray-600', 'bg-white');
        });
        this.classList.remove('border-gray-200', 'text-gray-600', 'bg-white');
        this.classList.add('border-black', 'bg-black', 'text-white', 'selected');
        update();
      });
    });

    amountInput?.addEventListener('input', () => {
      amountBtns.forEach(b => {
        b.classList.remove('border-black', 'bg-black', 'text-white', 'selected');
        b.classList.add('border-gray-200', 'text-gray-600', 'bg-white');
      });
      update();
    });

    form.querySelectorAll('input[name="donationType"]').forEach(r => r.addEventListener('change', update));
    frequencySelect?.addEventListener('change', update);
    coverFeesCheckbox?.addEventListener('change', update);
    coverFeesLabel?.addEventListener('click', () => {
      if (coverFeesCheckbox) { coverFeesCheckbox.checked = !coverFeesCheckbox.checked; update(); }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!donateBtn || !btnText || !btnLoading) return;

      const fd = new FormData(form);
      let amount = parseFloat(fd.get('amount')?.toString() || '0');
      const email = fd.get('email')?.toString() || '';
      const rawType = fd.get('donationType')?.toString() || 'one-time';
      const donationType = rawType === 'recurring' ? 'monthly' : 'one-time';
      const coverFees = fd.get('coverFees') === 'on';
      if (coverFees) amount += calcFee(amount);

      const errEl = form.querySelector('.form-error');
      const showErr = (msg: string) => { if (errEl) { errEl.textContent = msg; errEl.classList.remove('hidden'); } };
      const hideErr = () => { if (errEl) errEl.classList.add('hidden'); };
      hideErr();

      if (!amount || amount < 5) { showErr('Please enter an amount of at least $5.'); return; }
      if (amount > 999999) { showErr('Amount cannot exceed $999,999.'); return; }
      if (!email || !email.includes('@')) { showErr('Please enter a valid email address.'); return; }

      donateBtn.disabled = true;
      btnText.classList.add('hidden');
      btnLoading.classList.remove('hidden');

      try {
        const res = await fetch('https://api.shelterinastorm.org/api/v2/donation', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ amount, email, donationType, coverFees })
        });
        const data = await res.json();
        if (data.url) { window.location.href = data.url; }
        else { throw new Error(data.message || 'Failed to create donation session'); }
      } catch {
        showErr('There was an error processing your donation. Please try again.');
        donateBtn.disabled = false;
        btnText.classList.remove('hidden');
        btnLoading.classList.add('hidden');
      }
    });

    update();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDonationForms);
  } else {
    initDonationForms();
  }
</script>
