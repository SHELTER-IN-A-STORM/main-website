---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div
  id={id}
  class="fixed inset-0 bg-black/40 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4 overflow-y-auto"
  role="dialog"
  aria-modal="true"
>
  <div class="bg-white rounded-xl max-w-3xl w-full my-8 max-h-[90vh] overflow-y-auto modal-content">
    <div class="p-6 md:p-8">
      <div class="flex justify-end sticky top-0 bg-white z-10 pb-2">
        <button
          type="button"
          onclick={`closeTeamModal('${id}')`}
          class="p-2 hover:bg-gray-50 rounded-lg transition-colors"
          aria-label="Close modal"
        >
          <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

      <div class="grid md:grid-cols-[280px,1fr] gap-8">
        <div>
          <div class="aspect-square w-full overflow-hidden rounded-xl">
            <img
              id={`${id}-image`}
              src=""
              alt=""
              class="w-full h-full object-cover"
            />
          </div>
        </div>

        <div>
          <p id={`${id}-role`} class="text-sm text-gray-400 font-medium uppercase tracking-wide mb-1"></p>
          <h2 id={`${id}-title`} class="text-2xl md:text-3xl font-bold text-black mb-6"></h2>
          <p id={`${id}-bio`} class="text-gray-500 leading-relaxed"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  function openTeamModal(id, member) {
    const modal = document.getElementById(id);
    if (modal) {
      setTimeout(() => {
        const content = modal.querySelector('.modal-content');
        if (content) content.scrollTop = 0;
      }, 10);

      modal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';

      document.getElementById(id + '-title').textContent = member.name;
      document.getElementById(id + '-image').src = member.image;
      document.getElementById(id + '-image').alt = member.name;
      document.getElementById(id + '-role').textContent = member.role;
      document.getElementById(id + '-bio').textContent = member.bio;
    }
  }

  function closeTeamModal(id) {
    const modal = document.getElementById(id);
    if (modal) {
      modal.classList.add('hidden');
      document.body.style.overflow = '';
    }
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      document.querySelectorAll('[role="dialog"]').forEach(function(modal) {
        closeTeamModal(modal.id);
      });
    }
  });

  document.addEventListener('click', function(e) {
    var modals = document.querySelectorAll('[role="dialog"]:not(.hidden)');
    modals.forEach(function(modal) {
      var content = modal.querySelector('.modal-content');
      if (modal === e.target && content && !content.contains(e.target)) {
        closeTeamModal(modal.id);
      }
    });
  });
</script>
