---
import { siteConfig } from '../config/site';

const partners = siteConfig.shelter.donors;
const uniqueImageUrls = [...new Set(partners.map(p => p.logo).filter(Boolean))];
---

{uniqueImageUrls.map(url => (
  <link rel="preload" href={url} as="image" />
))}

<div class="relative overflow-hidden">
  <div class="absolute left-0 top-0 bottom-0 w-16 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
  <div class="absolute right-0 top-0 bottom-0 w-16 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

  <div class="flex items-center gap-12 donor-track">
    {[...partners, ...partners].map((partner) => (
      <a
        href={partner.url}
        target="_blank"
        rel="noopener noreferrer"
        class="flex-none grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
      >
        {partner.logo ? (
          <img
            src={partner.logo}
            alt={partner.name}
            class="h-10 w-auto object-contain"
            loading="eager"
            decoding="async"
          />
        ) : (
          <span class="text-sm font-semibold text-gray-400 whitespace-nowrap">{partner.name}</span>
        )}
      </a>
    ))}
  </div>
</div>

<style>
  .donor-track {
    animation: scroll 40s linear infinite;
    width: max-content;
  }
  .donor-track:hover {
    animation-play-state: paused;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
